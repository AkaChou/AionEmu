# Build outputs
target/
build/
out/

# Local dependency directories from the legacy Ant layout
**/libs/


# IDE and local tooling
.idea/
*.iml
.classpath
.project
.settings/
.vscode/
.codegraph
.cursor
.codex
.claude
.workbuddy
.zcode
.mcp.json

# Runtime logs and pid files
log/
*.log
*.pid
/log
/aion

# JFR flight recordings (per-run profiling output, never committed)
*.jfr

# Python bytecode caches from memory-bank maintenance scripts
__pycache__/
*.py[cod]

# OS files
.DS_Store
Thumbs.db

