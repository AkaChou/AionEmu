<?xml version="1.0" encoding="UTF-8"?>
<xs:schema version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="npc_walker">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="walker_template" minOccurs="0" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="routestep" minOccurs="1" maxOccurs="unbounded">
								<xs:complexType>
									<xs:attribute name="step" type="xs:positiveInteger" use="required"/>
									<xs:attribute name="x" type="xs:float" use="required"/>
									<xs:attribute name="y" type="xs:float" use="required"/>
									<xs:attribute name="z" type="xs:float" use="required"/>
									<xs:attribute name="rest_time" type="xs:nonNegativeInteger" use="optional"/>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
						<xs:attribute name="route_id" type="xs:string" use="required"/>
						<xs:attribute name="pool" type="xs:positiveInteger" use="required"/>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
