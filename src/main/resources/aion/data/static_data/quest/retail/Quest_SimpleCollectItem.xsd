<?xml version="1.0" encoding="UTF-8"?>
<!-- Quest_SimpleCollectItem.xml 表 schema（quest retail 表门禁用，2026-10-03 DOCTYPE 剥离同批）。
     镜像口径 = 装载器 fail-closed 规则 ∪ 观察形全域钉（证据 + 生成器：
     .agents/summary/quest-engine-native/p0b/）：
     - 双 NPC 为装载器必填；object1..4 可缺（五个 TEST 行无采集物 =
       装载器视为不可路由）；party_drop 出现即恒 "1"。
     Quest_SimpleCollectItem.xml schema (quest retail table gate, same batch as the 2026-10-03 DOCTYPE
     strip). Mirrors the loader fail-closed rules plus observed-universe shape pins (evidence + generator
     under `.agents/summary/quest-engine-native/p0b/`):
     - The two-NPC pair is loader-mandatory; object1..4 may be absent (the five TEST rows carry none =
       unroutable at load); party_drop is always "1" when present. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="quest_simplecollectitems">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="id" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <xs:all>
              <xs:element name="dev_name" minOccurs="1" type="xs:string"/>
              <xs:element name="acquired_npc_name" minOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="collapse"/>
                    <xs:minLength value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="object1" minOccurs="0" type="xs:string"/>
              <xs:element name="reward_npc_name" minOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="collapse"/>
                    <xs:minLength value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="con_quest" minOccurs="0">
                <xs:simpleType>
                  <xs:restriction base="xs:int">
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="object2" minOccurs="0" type="xs:string"/>
              <xs:element name="party_drop" minOccurs="0">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="object3" minOccurs="0" type="xs:string"/>
              <xs:element name="give_item" minOccurs="0" type="xs:string"/>
              <xs:element name="object4" minOccurs="0" type="xs:string"/>
              <xs:element name="cutsceneid1" minOccurs="0">
                <xs:simpleType>
                  <xs:restriction base="xs:int">
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="cs1_haction" minOccurs="0">
                <xs:simpleType>
                  <xs:restriction base="xs:int">
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="talk_npc1" minOccurs="0" type="xs:string"/>
              <xs:element name="talk_npc2" minOccurs="0" type="xs:string"/>
              <xs:element name="talk_npc3" minOccurs="0" type="xs:string"/>
              <xs:element name="reward_check" minOccurs="0" type="xs:string"/>
              <xs:element name="give_item1" minOccurs="0" type="xs:string"/>
              <xs:element name="remove_item2" minOccurs="0" type="xs:string"/>
            </xs:all>
            <xs:attribute name="id" use="required">
              <xs:simpleType>
                <xs:restriction base="xs:int">
                  <xs:minInclusive value="0"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="Quest_SimpleCollectItem-row-key-unique">
      <xs:selector xpath="id"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>
</xs:schema>
