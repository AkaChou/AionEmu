<?xml version="1.0" encoding="UTF-8"?>
<!-- retail-xml-retention.xml 表 schema（quest retail 表门禁用，2026-10-03 台账 XML 化同批）。
     镜像口径 = 装载器 fail-closed 规则 ∪ 观察形全域钉（证据 + 生成器：
     .agents/summary/quest-engine-native/p0b/）：
     - 行 = <quest>（quest_id 全表唯一）；owner/family 枚举 =
       当前观察闭域（新族/新形态须显式扩）；reason =
       OK/SCRIPTED/NO_TABLE/ADJUDICATED:<码>；owner=RETAIL_TABLE
       与 reason=OK 的共现、family="-" ⇒ XML_RETENTION 由
       RetailOwnershipGateTest 兜底。
     retail-xml-retention.xml schema (quest retail table gate, same batch as the 2026-10-03 ledger XML
     conversion). Mirrors the loader fail-closed rules plus observed-universe shape pins (evidence +
     generator under `.agents/summary/quest-engine-native/p0b/`):
     - Rows are <quest> (unique quest_id); the owner/family enums pin the observed closed domain (extend
       explicitly for new families); reason = OK/SCRIPTED/NO_TABLE/ADJUDICATED:<code>; the owner/reason and
       family co-occurrence constraints are RetailOwnershipGateTest concerns. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="retail_xml_retention">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="quest" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <xs:all>
              <xs:element name="quest_id" minOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:int">
                    <xs:minInclusive value="0"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="owner" minOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="RETAIL_TABLE"/>
                    <xs:enumeration value="XML_RETENTION"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="family" minOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="-"/>
                    <xs:enumeration value="CombineTask"/>
                    <xs:enumeration value="DataDriven"/>
                    <xs:enumeration value="SimpleCollectItem"/>
                    <xs:enumeration value="SimpleHunt"/>
                    <xs:enumeration value="SimpleItemPlay"/>
                    <xs:enumeration value="SimpleSerialHunt"/>
                    <xs:enumeration value="SimpleTalk"/>
                    <xs:enumeration value="SimpleUseItem"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="reason" minOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:pattern value="(OK|SCRIPTED|NO_TABLE|ADJUDICATED:[A-Za-z0-9_]+)"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="evidence" minOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="collapse"/>
                    <xs:minLength value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:all>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="retail-xml-retention-row-key-unique">
      <xs:selector xpath="quest"/>
      <xs:field xpath="quest_id"/>
    </xs:unique>
  </xs:element>
</xs:schema>
