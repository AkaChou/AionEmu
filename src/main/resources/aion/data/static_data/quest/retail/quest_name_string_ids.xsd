<?xml version="1.0" encoding="UTF-8"?>
<!-- quest_name_string_ids.xml 表 schema（quest retail 表门禁用，2026-10-03 台账 XML 化同批）。
     镜像口径 = 装载器 fail-closed 规则 ∪ 观察形全域钉（证据 + 生成器：
     .agents/summary/quest-engine-native/p0b/）：
     - 行 = <name_string_id>（key 全表唯一，形
       STR_QUEST_NAME_Q<questId>，数字段 = 装载器 substring 派生的 quest
       id）；string_id 非负 int 必填；string_id **允许重复**（镜像任务共用
       displayNameId，禁加 unique）。
     quest_name_string_ids.xml schema (quest retail table gate, same batch as the 2026-10-03 ledger XML
     conversion). Mirrors the loader fail-closed rules plus observed-universe shape pins (evidence +
     generator under `.agents/summary/quest-engine-native/p0b/`):
     - Rows are <name_string_id> (unique key shaped STR_QUEST_NAME_Q<questId>, whose digits are the quest id
       the loader derives via substring); string_id is a required non-negative int and may repeat (mirror
       quests share a displayNameId — do not add a uniqueness pin). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="quest_name_string_ids">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="name_string_id" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <xs:all>
              <xs:element name="key" minOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:pattern value="STR_QUEST_NAME_Q[0-9]+"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="string_id" minOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:int">
                    <xs:minInclusive value="0"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:all>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="quest_name_string_ids-row-key-unique">
      <xs:selector xpath="name_string_id"/>
      <xs:field xpath="key"/>
    </xs:unique>
  </xs:element>
</xs:schema>
