<?xml version="1.0" encoding="UTF-8"?>
<!-- retail-quest-string-ids.xml 表 schema（quest retail 表门禁用，2026-10-03 台账 XML 化同批）。
     镜像口径 = 装载器 fail-closed 规则 ∪ 观察形全域钉（证据 + 生成器：
     .agents/summary/quest-engine-native/p0b/）：
     - 行 = <quest_string_id>（key 全表唯一，形 STR_QUEST_SAY_* /
       STR_CHAT_*；string_id 非负 int）；body = 原版 <body>
       原文、可缺（旧格式兼容行——在仓资源 7/7 有正文，schema 按可缺钉以镜像装载器契约）。
     retail-quest-string-ids.xml schema (quest retail table gate, same batch as the 2026-10-03 ledger XML
     conversion). Mirrors the loader fail-closed rules plus observed-universe shape pins (evidence +
     generator under `.agents/summary/quest-engine-native/p0b/`):
     - Rows are <quest_string_id> (unique key shaped STR_QUEST_SAY_* / STR_CHAT_*; non-negative int
       string_id); body is the retail <body> text and is optional (legacy-format rows — the in-repo resource
       carries 7/7; the schema keeps it optional to mirror the loader contract). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="retail_quest_string_ids">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="quest_string_id" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <xs:all>
              <xs:element name="key" minOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:pattern value="STR_(QUEST_SAY|CHAT)_[A-Za-z0-9_]+"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="string_id" minOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:int">
                    <xs:minInclusive value="0"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="body" minOccurs="0" type="xs:string"/>
            </xs:all>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="retail-quest-string-ids-row-key-unique">
      <xs:selector xpath="quest_string_id"/>
      <xs:field xpath="key"/>
    </xs:unique>
  </xs:element>
</xs:schema>
