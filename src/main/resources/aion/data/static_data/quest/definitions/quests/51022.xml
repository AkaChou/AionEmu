<?xml version="1.0" encoding="UTF-8"?>
<!--
  51022 术古货箱族：客户端任务书三行阶梯（QE-051 批次 36）。
  Client journal rows (quest_q51022.html): row 0 kill counter ([%2]/3), row 1 talk to the squad shugo,
  row 2 find the item in the cargo box (701470) and hand it over ([%collectitem]). Pages: select4 SETPRO2
  (结束对话) -> select5 CHECK_USER_HAS_QUEST_ITEM (拿出道具) -> select_success SELECT_QUEST_REWARD.
  行 0「消灭活动怪 (/3)」-> 行 1「和术古对话」-> 行 2「在术古货物箱(701470)里找到 182215183 x3 交给 202549」。
  Migrated definition collapsed rows 1/2 and dropped the collect-step=4 gate of the box.
-->
<quest-definition id="51022" version="1">
  <metadata name="[Event] Just Shove-l It" display-name-id="1150069" min-level="9" max-level="2147483647" category="EVENT" cannot-share="true">
    <races>
      <race id="ASMODIANS"/>
    </races>
    <repeat max-repeat-count="255" cooldown-seconds="0" daily="true" weekly="false"/>
    <prerequisites>
      <quest id="51010"/>
    </prerequisites>
    <items>
      <item id="182215183" count="3"/>
    </items>
    <!--
      真端 drop_monster_1 = Event_Cargobox, drop_item_1 = quest_51018a, drop_prob=100, drop_each_member=1；
      旧 quest_data 的数值 ID 701470（npc 模板名 Event_Cargobox，ai=quest_use_item）已核对。
      The event cargobox grants the three exchange items; production lost the drop row during migration, so
      the npc-item-report turn-in could never be satisfied.
    -->
    <rewards>
      <reward kind="ITEM" id="188051770" amount="1"/>
      <reward kind="ITEM" id="160010214" amount="1"/>
      <reward kind="ITEM" id="160010215" amount="1"/>
    </rewards>
    <drops>
      <drop npc-id="701470" item-id="182215183" chance="100" each-member="true" collecting-step="1"/>
    </drops>
  </metadata>
  <progress>
    <bit-field name="var0" offset="0" width="6" min="0" max="63" persistence="PERSISTENT" scope="LOCAL"/>
  </progress>
  <nodes>
    <node label="unaccepted" status="NONE">
      <var name="var0" value="0"/>
    </node>
    <node label="started" status="START">
      <var name="var0" value="0"/>
    </node>
    <node label="s1" status="START">
      <var name="var0" value="1"/>
    </node>
    <node label="reward" status="REWARD">
      <var name="var0" value="2"/>
    </node>
    <node label="complete" status="COMPLETE">
      <var name="var0" value="0"/>
    </node>
  </nodes>
  <transitions>
    <!-- QE-051 自愈边：旧存档停在 REWARD 但 packed 行仍是 0，进入世界时补到领奖行 2。
         Heal edges: stale REWARD saves with packed row 0 are pushed to the reward row. -->
    <transition target="reward">
      <event>
        <enter-world/>
      </event>
      <conditions>
        <status-is status="REWARD"/>
        <variable-is field="var0" value="0"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="2"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <!-- QE-051 自愈边：旧存档停在 REWARD 但 packed 行仍是 1，进入世界时补到领奖行 2。
         Heal edges: stale REWARD saves with packed row 1 are pushed to the reward row. -->
    <transition target="reward">
      <event>
        <enter-world/>
      </event>
      <conditions>
        <status-is status="REWARD"/>
        <variable-is field="var0" value="1"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="2"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <!-- 接取：起始对话 / start dialogs -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT_NONE"/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="ASK_QUEST_ACCEPT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_ASK_QUEST_ACCEPT_WINDOW"/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="QUEST_ACCEPT_1"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="QUEST_ACCEPT_1"/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="QUEST_ACCEPT_SIMPLE"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <close-dialog/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="SETPRO1"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <close-dialog/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" actions="QUEST_REFUSE_1 QUEST_REFUSE_2 QUEST_REFUSE_SIMPLE"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="FINISH_DIALOG"/>
      </event>
      <after-commit>
        <dialog type="SHOW_SELECTION_PAGE" page="SELECT_QUEST"/>
      </after-commit>
    </transition>
    <!-- 行 0 -> 行 1：客户端 select4 页（结算击杀后 NPC 指向货箱的对话），SETPRO2 = 结束对话。
         Row 0 -> row 1: the client's select4 page ends the kill row. -->
    <transition source="started" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT4"/>
      </after-commit>
    </transition>
    <transition source="started" target="s1">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="SETPRO2"/>
      </event>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 行 1 -> 行 2：同一对话页在“和术古对话”行再确认一次，进入货箱取物行。 -->
    <transition source="s1" target="s1">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT4"/>
      </after-commit>
    </transition>
    <transition source="s1" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="SETPRO2"/>
      </event>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 收物行（行 1，START 态）：生产门禁 QuestInteractionObjectValidator 要求 quest_use_item 货箱的
         ACTION_ITEM_USE 资格路由落在 START 态且 var0 == collecting-step；零售 collecting_step=4 落在客户端第二组
         3 bit 槽位（3..5）即行 1，故收敛为 collecting-step=1。客户端 select5 页的“拿出道具”
         （CHECK_USER_HAS_QUEST_ITEM）在行 2 完成交付并打开 select_success(10002)。
         Loot row = row 1 (START) so the box's ACTION_ITEM_USE eligibility route carries collecting-step=1;
         the client's select5 check button hands the loot in on the reward row. -->
    <transition source="s1" target="s1">
      <event>
        <can-act template-id="701470" action-type="ACTION_ITEM_USE"/>
      </event>
    </transition>
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT5"/>
      </after-commit>
    </transition>
    <transition source="reward" target="reward" priority="0">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="CHECK_USER_HAS_QUEST_ITEM"/>
      </event>
      <conditions>
        <has-item item-id="182215183" count="3"/>
      </conditions>
      <actions>
        <remove-item item-id="182215183" count="3"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <transition source="reward" target="reward" priority="1">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="CHECK_USER_HAS_QUEST_ITEM"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="CHECK_USER_ITEM_FAIL"/>
      </after-commit>
    </transition>

    <npc-complete npc-id="202549" source="reward" target="complete" fixed-reward-indices="0 1 2" actions="SELECTED_QUEST_REWARD1..SELECTED_QUEST_NOREWARD" complete-reward-index="0" finish="SELECTION_DIALOG">
      <preview actions="USE_OBJECT SELECT_QUEST_REWARD"/>
    </npc-complete>
    <!-- check_user_item_fail 的关闭按钮（10002 领奖入口页由交付成功的 CHECK 路由打开 = select_success）。 -->
    <transition source="started" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="FINISH_DIALOG"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="FINISH_DIALOG"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
  </transitions>
</quest-definition>
