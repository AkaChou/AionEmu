<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:simpleType name="questGraphIdentifier">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="128"/>
			<xs:pattern value="[A-Za-z][A-Za-z0-9_.-]*"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphZoneName">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="192"/>
			<xs:pattern value="[A-Z_][A-Z0-9_.-]*"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphStateScope">
		<xs:restriction base="xs:string">
			<xs:enumeration value="PLAYER"/>
			<xs:enumeration value="PARTY"/>
			<xs:enumeration value="ALLIANCE"/>
			<xs:enumeration value="INSTANCE_RUN"/>
			<xs:enumeration value="WORLD"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphQuestStatus">
		<xs:restriction base="xs:string">
			<xs:enumeration value="NONE"/>
			<xs:enumeration value="START"/>
			<xs:enumeration value="REWARD"/>
			<xs:enumeration value="COMPLETE"/>
			<xs:enumeration value="LOCKED"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphQuestStatusList">
		<xs:restriction>
			<xs:simpleType><xs:list itemType="questGraphQuestStatus"/></xs:simpleType>
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphSetComparison">
		<xs:restriction base="xs:string">
			<xs:enumeration value="IN"/>
			<xs:enumeration value="NOT_IN"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphPlayerRace">
		<xs:restriction base="xs:string">
			<xs:enumeration value="ELYOS"/>
			<xs:enumeration value="ASMODIANS"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphPlayerClass">
		<xs:restriction base="xs:string">
			<xs:enumeration value="WARRIOR"/>
			<xs:enumeration value="GLADIATOR"/>
			<xs:enumeration value="TEMPLAR"/>
			<xs:enumeration value="SCOUT"/>
			<xs:enumeration value="ASSASSIN"/>
			<xs:enumeration value="RANGER"/>
			<xs:enumeration value="MAGE"/>
			<xs:enumeration value="SORCERER"/>
			<xs:enumeration value="SPIRIT_MASTER"/>
			<xs:enumeration value="PRIEST"/>
			<xs:enumeration value="CLERIC"/>
			<xs:enumeration value="CHANTER"/>
			<xs:enumeration value="TECHNIST"/>
			<xs:enumeration value="AETHERTECH"/>
			<xs:enumeration value="GUNSLINGER"/>
			<xs:enumeration value="MUSE"/>
			<xs:enumeration value="SONGWEAVER"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphPlayerRaceList">
		<xs:restriction>
			<xs:simpleType><xs:list itemType="questGraphPlayerRace"/></xs:simpleType>
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphPlayerClassList">
		<xs:restriction>
			<xs:simpleType><xs:list itemType="questGraphPlayerClass"/></xs:simpleType>
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphPlayerGender">
		<xs:restriction base="xs:string">
			<xs:enumeration value="MALE"/>
			<xs:enumeration value="FEMALE"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphAbyssRankId">
		<xs:restriction base="xs:positiveInteger">
			<xs:maxInclusive value="18"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphNumericComparison">
		<xs:restriction base="xs:string">
			<xs:enumeration value="EQUAL"/>
			<xs:enumeration value="GREATER"/>
			<xs:enumeration value="GREATER_EQUAL"/>
			<xs:enumeration value="LESSER"/>
			<xs:enumeration value="LESSER_EQUAL"/>
			<xs:enumeration value="NOT_EQUAL"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphVariableType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="INT"/>
			<xs:enumeration value="BOOLEAN"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="questGraphVariable">
		<xs:attribute name="name" type="questGraphIdentifier" use="required"/>
		<xs:attribute name="type" type="questGraphVariableType" use="required"/>
		<xs:attribute name="scope" type="questGraphStateScope" use="required"/>
		<xs:attribute name="initial" type="xs:string" use="required"/>
		<xs:attribute name="min" type="xs:int"/>
		<xs:attribute name="max" type="xs:int"/>
	</xs:complexType>

	<xs:complexType name="questGraphVariables">
		<xs:sequence>
			<xs:element name="variable" type="questGraphVariable" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="questGraphDialogEvent">
		<xs:attribute name="npc_id" type="xs:positiveInteger" use="required"/>
		<xs:attribute name="dialog" type="questGraphIdentifier" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphKillEvent">
		<xs:attribute name="npc_id" type="xs:positiveInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphAttackEvent">
		<xs:attribute name="npc_id" type="xs:positiveInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphPlayerDeathEvent"/>

	<xs:complexType name="questGraphKillInWorldEvent">
		<xs:attribute name="world_id" type="xs:nonNegativeInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphItemUseEvent">
		<xs:attribute name="item_id" type="xs:positiveInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphItemObtainedEvent">
		<xs:attribute name="item_id" type="xs:positiveInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphItemEquippedEvent">
		<xs:attribute name="item_id" type="xs:positiveInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphHouseItemUseEvent">
		<xs:attribute name="item_id" type="xs:positiveInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphWorldEnteredEvent"/>

	<xs:complexType name="questGraphZoneEnteredEvent">
		<xs:attribute name="zone_name" type="questGraphZoneName" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphZoneLeftEvent">
		<xs:attribute name="zone_name" type="questGraphZoneName" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphZoneMissionEndedEvent"/>

	<xs:complexType name="questGraphLevelUpEvent"/>

	<xs:complexType name="questGraphPlayerLogoutEvent"/>

	<xs:complexType name="questGraphQuestTimerEndedEvent">
		<xs:attribute name="timer" type="questGraphIdentifier" use="required"/>
	</xs:complexType>

	<xs:simpleType name="questGraphMovieId">
		<xs:restriction base="xs:positiveInteger">
			<xs:maxInclusive value="65535"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="questGraphMovieEndedEvent">
		<xs:attribute name="movie_id" type="questGraphMovieId" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphNpcProximityEvent">
		<xs:attribute name="npc_id" type="xs:positiveInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphEscortReachedTargetEvent"/>

	<xs:complexType name="questGraphEscortLostTargetEvent"/>

	<xs:complexType name="questGraphQuestStatusCondition">
		<xs:attribute name="quest_id" type="xs:positiveInteger"/>
		<xs:attribute name="op" type="questGraphSetComparison" use="required"/>
		<xs:attribute name="values" type="questGraphQuestStatusList" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphQuestVariableCondition">
		<xs:attribute name="variable" type="questGraphIdentifier" use="required"/>
		<xs:attribute name="op" type="questGraphNumericComparison" use="required"/>
		<xs:attribute name="value" type="xs:int" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphQuestRepeatAvailableCondition">
		<xs:attribute name="max_completions" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="255"/></xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="requires_deadline" type="xs:boolean" use="required"/>
		<xs:attribute name="expected" type="xs:boolean" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphQuestRewardCondition">
		<xs:attribute name="quest_id" type="xs:positiveInteger" use="required"/>
		<xs:attribute name="reward_index" type="xs:nonNegativeInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphQuestCompletionCountCondition">
		<xs:attribute name="quest_id" type="xs:positiveInteger" use="required"/>
		<xs:attribute name="op" type="questGraphNumericComparison" use="required"/>
		<xs:attribute name="count" type="xs:nonNegativeInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphPlayerLevelCondition">
		<xs:attribute name="min" type="xs:positiveInteger" use="required"/>
		<xs:attribute name="max" type="xs:positiveInteger"/>
	</xs:complexType>

	<xs:complexType name="questGraphPlayerRaceCondition">
		<xs:attribute name="values" type="questGraphPlayerRaceList" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphPlayerClassCondition">
		<xs:attribute name="values" type="questGraphPlayerClassList" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphPlayerGenderCondition">
		<xs:attribute name="value" type="questGraphPlayerGender" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphPlayerTitleCondition">
		<xs:attribute name="title_id" type="xs:positiveInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphPlayerAbyssRankCondition">
		<xs:attribute name="minimum" type="questGraphAbyssRankId" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphPlayerInventoryCondition">
		<xs:attribute name="item_id" type="xs:positiveInteger" use="required"/>
		<xs:attribute name="op" type="questGraphNumericComparison" use="required"/>
		<xs:attribute name="count" type="xs:nonNegativeInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphPlayerEquippedCondition">
		<xs:attribute name="item_id" type="xs:positiveInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphEmptyAction"/>

	<xs:complexType name="questGraphSetStatusAction">
		<xs:attribute name="status" type="questGraphQuestStatus" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphSetVariableAction">
		<xs:attribute name="variable" type="questGraphIdentifier" use="required"/>
		<xs:attribute name="value" type="xs:int" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphAddVariableAction">
		<xs:attribute name="variable" type="questGraphIdentifier" use="required"/>
		<xs:attribute name="delta" type="xs:int" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphSetCompletionCountAction">
		<xs:attribute name="count" type="xs:nonNegativeInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphAddCompletionCountAction">
		<xs:attribute name="delta" type="xs:int" use="required"/>
	</xs:complexType>

	<xs:simpleType name="questGraphQuestItemGrantMode">
		<xs:restriction base="xs:string">
			<xs:enumeration value="TOP_UP_TO"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphQuestItemRemovalMode">
		<xs:restriction base="xs:string">
			<xs:enumeration value="EXACT"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="questGraphGiveQuestItemAction">
		<xs:attribute name="item_id" type="xs:positiveInteger" use="required"/>
		<xs:attribute name="count" type="xs:positiveInteger" use="required"/>
		<xs:attribute name="mode" type="questGraphQuestItemGrantMode" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphRemoveQuestItemAction">
		<xs:attribute name="item_id" type="xs:positiveInteger" use="required"/>
		<xs:attribute name="count" type="xs:positiveInteger" use="required"/>
		<xs:attribute name="mode" type="questGraphQuestItemRemovalMode" use="required"/>
	</xs:complexType>

	<xs:simpleType name="questGraphRepeatDeadlineKind">
		<xs:restriction base="xs:string">
			<xs:enumeration value="DAILY"/>
			<xs:enumeration value="WEEKLY"/>
			<xs:enumeration value="ANCHORED_COOLDOWN"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphRepeatTimeBasis">
		<xs:restriction base="xs:string">
			<xs:enumeration value="SERVER_LOCAL"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphRepeatWeekday">
		<xs:restriction base="xs:string">
			<xs:enumeration value="MON"/>
			<xs:enumeration value="TUE"/>
			<xs:enumeration value="WED"/>
			<xs:enumeration value="THU"/>
			<xs:enumeration value="FRI"/>
			<xs:enumeration value="SAT"/>
			<xs:enumeration value="SUN"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphRepeatWeekdayList">
		<xs:restriction>
			<xs:simpleType><xs:list itemType="questGraphRepeatWeekday"/></xs:simpleType>
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="questGraphHour">
		<xs:restriction base="xs:nonNegativeInteger">
			<xs:maxInclusive value="23"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="questGraphFinishAction">
		<xs:attribute name="reward_index" type="xs:nonNegativeInteger" use="required"/>
		<xs:attribute name="repeat_kind" type="questGraphRepeatDeadlineKind"/>
		<xs:attribute name="time_basis" type="questGraphRepeatTimeBasis"/>
		<xs:attribute name="reset_hour" type="questGraphHour"/>
		<xs:attribute name="weekdays" type="questGraphRepeatWeekdayList"/>
		<xs:attribute name="cooldown_seconds" type="xs:positiveInteger"/>
	</xs:complexType>

	<xs:complexType name="questGraphStartTimerAction">
		<xs:attribute name="timer" type="questGraphIdentifier" use="required"/>
		<xs:attribute name="duration_seconds" type="xs:positiveInteger" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphEndTimerAction">
		<xs:attribute name="timer" type="questGraphIdentifier" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphSendDialogAction">
		<xs:attribute name="dialog_id" type="xs:positiveInteger" use="required"/>
	</xs:complexType>

	<xs:simpleType name="questGraphPlayerMessageChannel">
		<xs:restriction base="xs:string">
			<xs:enumeration value="BRIGHT_YELLOW_CENTER"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="questGraphSendPlayerMessageAction">
		<xs:attribute name="text" type="xs:string" use="required"/>
		<xs:attribute name="channel" type="questGraphPlayerMessageChannel" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphSendRepeatDeadlineMessageAction">
		<xs:attribute name="repeat_kind" type="questGraphRepeatDeadlineKind" use="required"/>
		<xs:attribute name="time_basis" type="questGraphRepeatTimeBasis" use="required"/>
		<xs:attribute name="reset_hour" type="questGraphHour" use="required"/>
		<xs:attribute name="weekdays" type="questGraphRepeatWeekdayList"/>
		<xs:attribute name="cooldown_seconds" type="xs:positiveInteger"/>
	</xs:complexType>

	<xs:complexType name="questGraphConditions">
		<xs:choice minOccurs="1" maxOccurs="unbounded">
			<xs:element name="quest-status" type="questGraphQuestStatusCondition"/>
			<xs:element name="quest-variable" type="questGraphQuestVariableCondition"/>
			<xs:element name="quest-repeat-available" type="questGraphQuestRepeatAvailableCondition"/>
			<xs:element name="quest-collect-items" type="questGraphEmptyAction"/>
			<xs:element name="quest-reward" type="questGraphQuestRewardCondition"/>
			<xs:element name="quest-completion-count" type="questGraphQuestCompletionCountCondition"/>
			<xs:element name="player-level" type="questGraphPlayerLevelCondition"/>
			<xs:element name="player-race" type="questGraphPlayerRaceCondition"/>
			<xs:element name="player-class" type="questGraphPlayerClassCondition"/>
			<xs:element name="player-gender" type="questGraphPlayerGenderCondition"/>
			<xs:element name="player-title" type="questGraphPlayerTitleCondition"/>
			<xs:element name="player-abyss-rank" type="questGraphPlayerAbyssRankCondition"/>
			<xs:element name="player-inventory" type="questGraphPlayerInventoryCondition"/>
			<xs:element name="player-equipped" type="questGraphPlayerEquippedCondition"/>
		</xs:choice>
	</xs:complexType>

	<xs:complexType name="questGraphActions">
		<xs:choice minOccurs="1" maxOccurs="unbounded">
			<xs:element name="start-quest" type="questGraphEmptyAction"/>
			<xs:element name="set-quest-status" type="questGraphSetStatusAction"/>
			<xs:element name="set-quest-variable" type="questGraphSetVariableAction"/>
			<xs:element name="add-quest-variable" type="questGraphAddVariableAction"/>
			<xs:element name="set-completion-count" type="questGraphSetCompletionCountAction"/>
			<xs:element name="add-completion-count" type="questGraphAddCompletionCountAction"/>
			<xs:element name="give-quest-item" type="questGraphGiveQuestItemAction"/>
			<xs:element name="remove-quest-item" type="questGraphRemoveQuestItemAction"/>
			<xs:element name="remove-collected-items" type="questGraphEmptyAction"/>
			<xs:element name="finish-quest" type="questGraphFinishAction"/>
			<xs:element name="start-quest-timer" type="questGraphStartTimerAction"/>
			<xs:element name="end-quest-timer" type="questGraphEndTimerAction"/>
			<xs:element name="send-dialog" type="questGraphSendDialogAction"/>
			<xs:element name="close-dialog" type="questGraphEmptyAction"/>
			<xs:element name="show-quest-list" type="questGraphEmptyAction"/>
			<xs:element name="sync-quest-status" type="questGraphEmptyAction"/>
			<xs:element name="send-repeat-deadline-message" type="questGraphSendRepeatDeadlineMessageAction"/>
			<xs:element name="send-player-message" type="questGraphSendPlayerMessageAction"/>
		</xs:choice>
	</xs:complexType>

	<xs:complexType name="questGraphTransition">
		<xs:sequence>
			<xs:choice>
				<xs:element name="dialog" type="questGraphDialogEvent"/>
				<xs:element name="kill" type="questGraphKillEvent"/>
				<xs:element name="attack" type="questGraphAttackEvent"/>
				<xs:element name="player-death" type="questGraphPlayerDeathEvent"/>
				<xs:element name="kill-in-world" type="questGraphKillInWorldEvent"/>
				<xs:element name="item-use" type="questGraphItemUseEvent"/>
				<xs:element name="item-obtained" type="questGraphItemObtainedEvent"/>
				<xs:element name="item-equipped" type="questGraphItemEquippedEvent"/>
				<xs:element name="house-item-use" type="questGraphHouseItemUseEvent"/>
				<xs:element name="world-entered" type="questGraphWorldEnteredEvent"/>
					<xs:element name="zone-entered" type="questGraphZoneEnteredEvent"/>
					<xs:element name="zone-left" type="questGraphZoneLeftEvent"/>
					<xs:element name="zone-mission-ended" type="questGraphZoneMissionEndedEvent"/>
					<xs:element name="level-up" type="questGraphLevelUpEvent"/>
					<xs:element name="player-logout" type="questGraphPlayerLogoutEvent"/>
					<xs:element name="quest-timer-ended" type="questGraphQuestTimerEndedEvent"/>
					<xs:element name="movie-ended" type="questGraphMovieEndedEvent"/>
					<xs:element name="npc-proximity" type="questGraphNpcProximityEvent"/>
					<xs:element name="escort-reached-target" type="questGraphEscortReachedTargetEvent"/>
					<xs:element name="escort-lost-target" type="questGraphEscortLostTargetEvent"/>
			</xs:choice>
			<xs:element name="conditions" type="questGraphConditions" minOccurs="0"/>
			<xs:element name="actions" type="questGraphActions" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="id" type="questGraphIdentifier" use="required"/>
		<xs:attribute name="priority" type="xs:nonNegativeInteger" use="required"/>
		<xs:attribute name="to" type="questGraphIdentifier" use="required"/>
	</xs:complexType>

	<xs:complexType name="questGraphNode">
		<xs:sequence>
			<xs:element name="transition" type="questGraphTransition" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="id" type="questGraphIdentifier" use="required"/>
		<xs:attribute name="terminal" type="xs:boolean" default="false"/>
	</xs:complexType>

	<xs:complexType name="questGraphDefinition">
		<xs:sequence>
			<xs:element name="variables" type="questGraphVariables" minOccurs="0"/>
			<xs:element name="node" type="questGraphNode" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="quest_id" type="xs:positiveInteger" use="required"/>
		<xs:attribute name="version" type="xs:positiveInteger" use="required"/>
		<xs:attribute name="scope" type="questGraphStateScope" use="required"/>
		<xs:attribute name="initial_node" type="questGraphIdentifier" use="required"/>
	</xs:complexType>

	<xs:element name="quest_graphs">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="quest_graph" type="questGraphDefinition" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
