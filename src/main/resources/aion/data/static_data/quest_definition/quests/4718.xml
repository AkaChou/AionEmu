<?xml version="1.0" encoding="UTF-8"?>
<quest-definition id="4718" version="1">
  <metadata name="[Group] Pressing The Attack" display-name-id="1120011" min-level="46" max-level="50" category="QUEST">
    <races>
      <race id="ASMODIANS"/>
    </races>
    <repeat max-repeat-count="255" cooldown-seconds="0" daily="false" weekly="false"/>
    <rewards>
      <reward kind="EXP" id="0" amount="2719217"/>
      <reward kind="ITEM" id="186000469" amount="1"/>
    </rewards>
  </metadata>
  <progress>
    <bit-field name="var0" offset="0" width="1" min="0" max="1" persistence="PERSISTENT" scope="LOCAL"/>
    <bit-field name="var1" offset="6" width="2" min="0" max="3" persistence="PERSISTENT" scope="LOCAL"/>
    <bit-field name="var2" offset="12" width="4" min="0" max="8" persistence="PERSISTENT" scope="LOCAL"/>
  </progress>
  <nodes>
    <node label="unaccepted" status="NONE">
      <var name="var0" value="0"/>
      <var name="var1" value="0"/>
      <var name="var2" value="0"/>
    </node>
    <node label="started" status="START">
      <var name="var0" value="0"/>
    </node>
    <node label="s1" status="START">
      <var name="var0" value="1"/>
    </node>
    <node label="reward" status="REWARD">
      <var name="var0" value="1"/>
      <var name="var1" value="3"/>
      <var name="var2" value="8"/>
    </node>
    <node label="complete" status="COMPLETE">
      <var name="var0" value="1"/>
      <var name="var1" value="3"/>
      <var name="var2" value="8"/>
    </node>
  </nodes>
  <transitions>
    <!-- 接取介绍。 Quest-start intro dialog. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="279042" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT_NONE"/>
      </after-commit>
    </transition>
    <!-- 接受任务。 Accept the quest. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="279042" action="ASK_QUEST_ACCEPT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_ASK_QUEST_ACCEPT_WINDOW"/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="279042" action="QUEST_ACCEPT_1"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="QUEST_ACCEPT_1"/>
      </after-commit>
    </transition>
    <!-- 拒绝任务。 Decline the quest. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="279042" action="QUEST_REFUSE_1"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="QUEST_REFUSE_1"/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="279042" actions="QUEST_REFUSE_2 QUEST_REFUSE_SIMPLE"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 击杀 Balaur 推进击杀计数。 Kill Balaur to advance the kill counter. -->
    <transition source="started" target="started">
      <event>
        <kill-npc npc-id="214814"/>
      </event>
      <conditions>
        <variable-below field="var2" value="8"/>
      </conditions>
      <actions>
        <increment-variable field="var2" delta="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <transition source="s1" target="s1">
      <event>
        <kill-npc npc-id="214814"/>
      </event>
      <conditions>
        <variable-below field="var2" value="8"/>
      </conditions>
      <actions>
        <increment-variable field="var2" delta="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <!-- Dredgion 结算推进轮次计数。 Dredgion settlement advances the round counter. -->
    <transition source="started" target="started">
      <event>
        <dredgion-reward/>
      </event>
      <conditions>
        <variable-below field="var1" value="3"/>
      </conditions>
      <actions>
        <increment-variable field="var1" delta="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <transition source="s1" target="s1">
      <event>
        <dredgion-reward/>
      </event>
      <conditions>
        <variable-below field="var1" value="3"/>
      </conditions>
      <actions>
        <increment-variable field="var1" delta="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <!-- 开始阶段 NPC 对话。 Early-stage NPC dialog. -->
    <transition source="started" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="278001" action="QUEST_SELECT"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT1"/>
      </after-commit>
    </transition>
    <!-- 收集完成后的提示。 Completion prompt after both counters are met. -->
    <transition source="s1" target="s1">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="278001" action="QUEST_SELECT"/>
      </event>
      <conditions>
        <variable-is field="var1" value="3"/>
        <variable-is field="var2" value="8"/>
      </conditions>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <!-- 推进到下一阶段。 Advance to the next stage. -->
    <transition source="started" target="s1">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="278001" action="SETPRO1"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 双条件达成后进入奖励阶段。 Enter the reward stage once both counters are met. -->
    <transition source="s1" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="278001" action="SELECT_QUEST_REWARD"/>
      </event>
      <conditions>
        <variable-is field="var1" value="3"/>
        <variable-is field="var2" value="8"/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_SELECT_QUEST_REWARD_WINDOW1"/>
      </after-commit>
    </transition>
    <!-- 奖励阶段对话。 Reward-stage dialog. -->
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="278001" action="USE_OBJECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="278001" action="SELECT_QUEST_REWARD"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_SELECT_QUEST_REWARD_WINDOW1"/>
      </after-commit>
    </transition>
    <!-- 选择奖励并完成。 Choose reward and complete. -->
    <transition source="reward" target="complete">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="278001" actions="SELECTED_QUEST_REWARD1..SELECTED_QUEST_NOREWARD"/>
      </event>
      <actions>
        <grant-reward kind="EXP" id="0" amount="2719217" amount-mode="QUEST_BASE"/>
        <grant-reward kind="ITEM" id="186000469" amount="1"/>
        <complete-quest reward-index="0"/>
      </actions>
      <after-commit>
        <refresh-player-stats/>
        <sync-quest-state mode="COMPLETION"/>
        <dialog type="SHOW_SELECTION_PAGE" page="SELECT_QUEST"/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="279042" action="FINISH_DIALOG"/>
      </event>
      <after-commit>
        <dialog type="SHOW_SELECTION_PAGE" page="SELECT_QUEST"/>
      </after-commit>
    </transition>
    <transition source="started" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="279042" action="FINISH_DIALOG"/>
      </event>
      <after-commit>
        <dialog type="SHOW_SELECTION_PAGE" page="SELECT_QUEST"/>
      </after-commit>
    </transition>
  </transitions>
</quest-definition>
