<?xml version="1.0" encoding="UTF-8"?>
<quest-definition id="25533" version="1">
  <metadata name="[Daily] Protect Saphora Forest" display-name-id="1802185" min-level="68" max-level="998" category="SEEN_MARKER">
    <races>
      <race id="ASMODIANS"/>
    </races>
    <repeat max-repeat-count="255" cooldown-seconds="0" daily="true" weekly="false" cycles="ALL"/>
    <rewards>
      <reward kind="EXP" id="0" amount="77328000"/>
      <reward kind="ITEM" id="188054912" amount="1"/>
    </rewards>
    <start-conditions>
      <condition type="finished" quest-id="25550"/>
    </start-conditions>
  </metadata>
  <progress>
    <bit-field name="var0" offset="0" width="6" min="0" max="63" persistence="PERSISTENT" scope="LOCAL"/>
    <bit-field name="var1" offset="6" width="6" min="0" max="30" persistence="PERSISTENT" scope="LOCAL"/>
  </progress>
  <nodes>
    <node label="unaccepted" status="NONE">
      <var name="var0" value="0"/>
      <var name="var1" value="0"/>
    </node>
    <node label="started" status="START"/>
    <node label="reward" status="REWARD">
      <var name="var0" value="1"/>
      <var name="var1" value="30"/>
    </node>
    <node label="complete" status="COMPLETE">
      <var name="var0" value="0"/>
      <var name="var1" value="0"/>
    </node>
  </nodes>
  <transitions>
    <dialog type="NPC_START" npc-id="806112" source="unaccepted" target="started" selection-sources="unaccepted" start-page="SELECT_NONE"/>
    <!-- 击杀 0..28 累积计数，同时将 var0 保持为 0 自愈历史脏数据 -->
    <transition source="started" target="started" priority="1">
      <event>
        <kill-npc npc-ids="240467 240469 237613 237618 237623 238840 238845 238850 238855 238860 238865 238870 238875 238880 238885 238890 238895 238900 238905 238910 238915 238920 238925"/>
      </event>
      <conditions>
        <variable-below field="var1" value="29"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="0"/>
        <increment-variable field="var1" delta="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <!-- 第 30 次击杀达成，var0 置 1 激活下一步客户端对话，进入 REWARD 状态 -->
    <transition source="started" target="reward" priority="0">
      <event>
        <kill-npc npc-ids="240467 240469 237613 237618 237623 238840 238845 238850 238855 238860 238865 238870 238875 238880 238885 238890 238895 238900 238905 238910 238915 238920 238925"/>
      </event>
      <conditions>
        <variable-at-least field="var1" value="29"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
        <set-variable field="var1" value="30"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <!-- 满计数恢复路线：若处于 started 但击杀已满，允许与报告 NPC 对话报告并转移至 reward -->
    <transition source="started" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="806112" action="QUEST_SELECT"/>
      </event>
      <conditions>
        <variable-at-least field="var1" value="30"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <transition source="started" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="806112" action="SELECT_QUEST_REWARD"/>
      </event>
      <conditions>
        <variable-at-least field="var1" value="30"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_SELECT_QUEST_REWARD_WINDOW1"/>
      </after-commit>
    </transition>
    <!-- 领奖阶段：向报告 NPC 报告并领取奖励 -->
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="806112" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <transition source="reward" target="complete">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="806112" actions="SELECTED_QUEST_REWARD1..SELECTED_QUEST_NOREWARD" />
      </event>
      <actions>
        <grant-reward kind="EXP" id="0" amount="77328000" amount-mode="QUEST_BASE" />
        <grant-reward kind="ITEM" id="188054912" amount="1" />
        <complete-quest reward-index="0" />
      </actions>
      <after-commit>
        <refresh-player-stats />
        <sync-quest-state mode="COMPLETION" />
        <dialog type="SHOW_SELECTION_PAGE" page="SELECT_QUEST" />
      </after-commit>
    </transition>
  </transitions>
</quest-definition>
