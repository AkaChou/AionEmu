  <progress>
    <!-- 客户端 quest_monster.csv：SECTION_0..4 是 5 只冰冻独眼巨人的独立计数（各 1），
         全部由 SECTION_5==0 门控；旧 handler 用 setQuestVarById(0..4) 与 setQuestVarById(5,1/0) 对齐。
         Client quest_monster.csv: SECTION_0..4 are the five independent cyclops counters, all gated
         by SECTION_5==0; the legacy handler wrote setQuestVarById(0..4) and setQuestVarById(5,1/0). -->
    <bit-field name="var0" offset="0" width="1" min="0" max="1" persistence="PERSISTENT" scope="LOCAL"/>
    <bit-field name="var1" offset="6" width="1" min="0" max="1" persistence="PERSISTENT" scope="LOCAL"/>
    <bit-field name="var2" offset="12" width="1" min="0" max="1" persistence="PERSISTENT" scope="LOCAL"/>
    <bit-field name="var3" offset="18" width="1" min="0" max="1" persistence="PERSISTENT" scope="LOCAL"/>
    <bit-field name="var4" offset="24" width="1" min="0" max="1" persistence="PERSISTENT" scope="LOCAL"/>
    <!-- var5（SECTION_5）：接取后置 1 锁住五只计数，戴尔里斯对话后置 0 解锁（旧 handler 同值语义）。 -->
    <!-- var5 (SECTION_5): 1 right after accept locks the five counters, the Delris dialog clears it. -->
    <bit-field name="var5" offset="30" width="1" min="0" max="1" persistence="PERSISTENT" scope="LOCAL"/>
  </progress>
  <nodes>
    <node label="unaccepted" status="NONE"/>
    <node label="started" status="START">
      <var name="var5" value="1"/>
    </node>
    <!-- hunted：戴尔里斯对话后解锁的击杀阶段；只投影 var5，保留实时计数（同 13705 的 started）。 -->
    <node label="hunted" status="START">
      <var name="var5" value="0"/>
    </node>
    <node label="reward" status="REWARD">
      <var name="var0" value="1"/>
      <var name="var1" value="1"/>
      <var name="var2" value="1"/>
      <var name="var3" value="1"/>
      <var name="var4" value="1"/>
