  <transitions>
    <!-- 迁移修复：旧存档 REWARD 但五段计数未落齐（旧 XML 的 reward 投影 var0=0）。
         报告 NPC 上的 TALK 自愈与既有 reward->reward QUEST_SELECT 路线同事件同来源，
         编译器判定为 AMBIGUOUS_TRANSITION，因此只保留 ENTER_WORLD 迁移（重登/换图即自愈）。
         Migration repair for legacy REWARD saves whose five counters were never projected. The
         talk self-heal would collide with the existing reward->reward QUEST_SELECT route on the
         same NPC and fail compilation as AMBIGUOUS_TRANSITION, so only the ENTER_WORLD route is kept. -->
    <transition target="reward">
      <event>
        <enter-world/>
      </event>
      <conditions>
        <status-is status="REWARD"/>
        <variable-below field="var0" value="1"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
        <set-variable field="var1" value="1"/>
        <set-variable field="var2" value="1"/>
        <set-variable field="var3" value="1"/>
        <set-variable field="var4" value="1"/>
        <set-variable field="var5" value="0"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="unaccepted">
