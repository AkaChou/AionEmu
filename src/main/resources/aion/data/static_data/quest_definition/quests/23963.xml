    <node label="complete" status="COMPLETE">
      <var name="var0" value="1"/>
      <var name="var1" value="1"/>
    </node>
  </nodes>
  <transitions>
    <!-- 接取对话：NPC 835221 显示任务介绍。 Start dialog: NPC 835221 shows the quest intro. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="835221" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT_NONE"/>
      </after-commit>
    </transition>
    <!-- 接受任务并开始。 Accept quest and start. -->
    <transition source="unaccepted" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="835221" action="QUEST_ACCEPT_1"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="QUEST_ACCEPT_1"/>
      </after-commit>
    </transition>
    <!-- 简化接受。 Simple accept. -->
    <transition source="unaccepted" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="835221" action="QUEST_ACCEPT_SIMPLE"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 拒绝任务：关闭对话框。 Refuse quest: close dialog. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="835221" actions="QUEST_REFUSE_1 QUEST_REFUSE_2 QUEST_REFUSE_SIMPLE"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 任务日志重新打开任务列表。 Quest log reopens the quest list. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="835221" action="FINISH_DIALOG"/>
      </event>
      <after-commit>
        <dialog type="SHOW_SELECTION_PAGE" page="SELECT_QUEST"/>
      </after-commit>
    </transition>
    <!-- 击杀 246703/246704：var1 置 1 且 var0 置 1 进入 REWARD。 Kill 246703/246704: set var1=1, var0=1, enter REWARD. -->
    <transition source="started" target="reward">
      <event>
        <kill-npc npc-ids="246703 246704"/>
      </event>
      <actions>
        <set-variable field="var0" value="1"/>
        <set-variable field="var1" value="1"/>
        <set-status status="REWARD"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <!-- 奖励：与 835220 结算。 Reward: settle with 835220. -->
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="835220" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <npc-complete npc-id="835220" source="reward" target="complete" fixed-reward-indices="0 1 2" actions="SELECTED_QUEST_REWARD1..SELECTED_QUEST_NOREWARD" complete-reward-index="0" finish="SELECTION_DIALOG">
      <preview actions="SELECT_QUEST_REWARD"/>
    </npc-complete>
  </transitions>
