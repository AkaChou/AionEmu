    <rewards>
      <reward kind="GOLD" id="0" amount="47400"/>
      <reward kind="EXP" id="0" amount="633457"/>
      <reward kind="ITEM" id="186000008" amount="2"/>
    </rewards>
    <drops>
      <drop npc-id="213039" item-id="182204421" chance="80" each-member="true" collecting-step="0"/>
      <drop npc-id="213040" item-id="182204421" chance="80" each-member="true" collecting-step="0"/>
    </drops>
  </metadata>
  <progress>
