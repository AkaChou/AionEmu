<?xml version="1.0" encoding="UTF-8"?>
<quest-definition id="4087" version="1">
  <metadata name="No Ordinary Branch" display-name-id="1114086" min-level="48" max-level="2147483647" category="QUEST" cannot-share="true">
    <races>
      <race id="ASMODIANS"/>
    </races>
    <work-items>
      <item id="182209046" count="1"/>
    </work-items>
    <rewards>
      <reward kind="EXP" id="0" amount="4952329"/>
      <reward kind="ITEM" id="186000019" amount="6"/>
    </rewards>
  </metadata>
  <progress>
    <bit-field name="var0" offset="0" width="2" min="0" max="1" persistence="PERSISTENT" scope="LOCAL"/>
  </progress>
  <nodes>
    <node label="unaccepted" status="NONE">
      <var name="var0" value="0"/>
    </node>
    <node label="started" status="START">
      <var name="var0" value="0"/>
    </node>
    <node label="reward" status="REWARD">
      <var name="var0" value="1"/>
    </node>
    <node label="complete" status="COMPLETE">
      <var name="var0" value="1"/>
    </node>
  </nodes>
  <transitions>
    <!-- 未接取时使用任务物品显示接取确认框。 Using the quest item while unaccepted shows the start-confirm dialog. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <use-item item-id="182209046"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_ASK_QUEST_ACCEPT_WINDOW"/>
      </after-commit>
    </transition>
    <!-- 接受任务。 Accept the quest. -->
    <transition source="unaccepted" target="started">
      <event>
        <dialog type="QUEST_ACTION" action="QUEST_ACCEPT_1"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="QUEST_ACCEPT_1"/>
      </after-commit>
    </transition>
    <!-- 拒绝任务。 Decline the quest. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="QUEST_ACTION" action="QUEST_REFUSE_1"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 交付 NPC 对话。 Dialog with the delivery NPC. -->
    <transition source="started" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="205201" action="QUEST_SELECT"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT5"/>
      </after-commit>
    </transition>
    <!-- 交付任务物品并进入奖励阶段。 Hand over the quest item and enter the reward stage. -->
    <transition source="started" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="205201" action="SELECT_QUEST_REWARD"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <actions>
        <remove-item item-id="182209046" count="1"/>
        <set-variable field="var0" value="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_SELECT_QUEST_REWARD_WINDOW1"/>
      </after-commit>
    </transition>
    <!-- 奖励阶段对话。 Reward-stage dialog. -->
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="205201" action="USE_OBJECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="205201" action="SELECT_QUEST_REWARD"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_SELECT_QUEST_REWARD_WINDOW1"/>
      </after-commit>
    </transition>
    <!-- 选择奖励并完成。 Choose reward and complete. -->
    <transition source="reward" target="complete">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="205201" actions="SELECTED_QUEST_REWARD1..SELECTED_QUEST_NOREWARD"/>
      </event>
      <actions>
        <grant-reward kind="EXP" id="0" amount="4952329" amount-mode="QUEST_BASE"/>
        <grant-reward kind="ITEM" id="186000019" amount="6"/>
        <complete-quest reward-index="0"/>
      </actions>
      <after-commit>
        <refresh-player-stats/>
        <sync-quest-state mode="COMPLETION"/>
        <dialog type="SHOW_SELECTION_PAGE" page="SELECT_QUEST"/>
      </after-commit>
    </transition>
  </transitions>
</quest-definition>
