<?xml version="1.0" encoding="UTF-8"?>
<quest-definition id="27152" version="1">
  <!-- 每日任务：击杀 219501 共 3 只后向 831234 报告。可重复（255 次）。
       Daily quest: kill 3x 219501, then report to 831234. Repeatable (255x). -->
  <metadata name="[Daily] Village Defense" display-name-id="1150191" min-level="21" max-level="2147483647" category="CHALLENGE_TASK" cannot-share="true">
    <races>
      <race id="ASMODIANS"/>
    </races>
    <repeat max-repeat-count="255" cooldown-seconds="0" daily="true" weekly="false" cycles="ALL"/>
    <rewards>
      <reward kind="EXP" id="0" amount="56346"/>
      <reward kind="ITEM" id="186000146" amount="1"/>
    </rewards>
  </metadata>
  <progress>
    <bit-field name="var0" offset="0" width="6" min="0" max="63" persistence="PERSISTENT" scope="LOCAL"/>
  </progress>
  <nodes>
    <node label="unaccepted" status="NONE">
      <var name="var0" value="0"/>
    </node>
    <node label="started" status="START">
      <var name="var0" value="0"/>
    </node>
    <node label="k1" status="START">
      <var name="var0" value="1"/>
    </node>
    <node label="k2" status="START">
      <var name="var0" value="2"/>
    </node>
    <node label="k3" status="START">
      <var name="var0" value="3"/>
    </node>
    <node label="reward" status="REWARD">
      <var name="var0" value="3"/>
    </node>
    <node label="complete" status="COMPLETE">
      <var name="var0" value="0"/>
    </node>
  </nodes>
  <transitions>
    <!-- 接取：预览、拒绝与选择对话 / Accept: preview, decline and selection dialogs -->
    <dialog type="NPC_START" npc-id="831234" source="unaccepted" target="started" selection-sources="unaccepted started" start-page="SELECT1"/>
    <!-- 击杀：每杀一只 var0+1 / kills: +1 var0 per 219501 -->
    <kill-chain nodes="started k1 k2 k3">
      <event>
        <kill-npc npc-id="219501"/>
      </event>
    </kill-chain>
    <!-- 终态：报告 / terminal: report to 831234 -->
    <dialog type="NPC_REPORT" npc-id="831234" source="k3" target="reward" page="SELECT2"/>
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="831234" actions="USE_OBJECT SELECT_QUEST_REWARD"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_SELECT_QUEST_REWARD_WINDOW1"/>
      </after-commit>
    </transition>
    <!-- 奖励：发放并完成 / reward: grant and complete -->
    <transition source="reward" target="complete">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="831234" actions="SELECTED_QUEST_REWARD1..SELECTED_QUEST_NOREWARD"/>
      </event>
      <actions>
        <grant-reward kind="EXP" id="0" amount="56346" amount-mode="QUEST_BASE"/>
        <grant-reward kind="ITEM" id="186000146" amount="1"/>
        <complete-quest reward-index="0"/>
      </actions>
      <after-commit>
        <refresh-player-stats/>
        <sync-quest-state mode="COMPLETION"/>
        <dialog type="SHOW_SELECTION_PAGE" page="SELECT_QUEST"/>
      </after-commit>
    </transition>
  </transitions>
</quest-definition>
