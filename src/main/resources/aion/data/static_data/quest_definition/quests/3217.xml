<?xml version="1.0" encoding="UTF-8"?>
<quest-definition id="3217" version="1">
  <metadata name="[Instance/Group] Captured Guardian" display-name-id="1103040" min-level="43" max-level="2147483647" category="QUEST" cannot-share="true">
