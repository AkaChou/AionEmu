  <transitions>
    <!-- 使用 Lepharist 印记打开接取提示页。 Using the Lepharist's Mark opens the accept prompt. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <use-item item-id="182213273"/>
      </event>
      <after-commit>
        <show-quest-dialog dialog-id="4"/>
      </after-commit>
    </transition>
    <!-- 接受接取。 Accept the quest. -->
    <transition source="unaccepted" target="started">
      <event>
        <quest-dialog dialog-id="1002"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 拒绝接取。 Refuse the quest. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <quest-dialog dialog-id="1003"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 与 801189 对话查看提示。 Talk to 801189 for the hint page. -->
    <transition source="started" target="started">
      <event>
        <talk-to-npc npc-id="801189" dialog-id="31"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <after-commit>
        <show-quest-dialog dialog-id="2375"/>
      </after-commit>
    </transition>
    <!-- 选择奖励进入领奖页。 Select reward to reach the reward page. -->
    <transition source="started" target="reward">
      <event>
        <talk-to-npc npc-id="801189" dialog-id="1009"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <show-quest-dialog dialog-id="5"/>
      </after-commit>
    </transition>
    <!-- 领奖页。 Reward page. -->
    <npc-complete npc-id="801189" source="reward" target="complete" fixed-reward-indices="0" dialog-ids="8..23" complete-reward-index="0" preview-dialog-ids="-1 1009" finish="SELECTION_DIALOG"/>
  </transitions>
