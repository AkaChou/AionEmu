<?xml version="1.0" encoding="UTF-8"?>
<quest-definition id="16904" version="1">
  <metadata name="Lepharist's Mark" display-name-id="1140688" min-level="38" max-level="2147483647" category="QUEST" cannot-share="true">
    <races>
      <race id="ELYOS"/>
    </races>
    <repeat max-repeat-count="50" cooldown-seconds="0" daily="false" weekly="false"/>
    <work-items>
      <item id="182213273" count="1"/>
    </work-items>
    <rewards>
      <reward kind="EXP" id="0" amount="944314"/>
    </rewards>
  </metadata>
  <progress>
    <bit-field name="var0" offset="0" width="2" min="0" max="1" persistence="PERSISTENT" scope="LOCAL"/>
  </progress>
  <nodes>
    <node label="unaccepted" status="NONE">
      <var name="var0" value="0"/>
    </node>
    <node label="started" status="START">
      <var name="var0" value="0"/>
    </node>
    <node label="reward" status="REWARD">
      <var name="var0" value="1"/>
    </node>
    <node label="complete" status="COMPLETE"/>
  </nodes>
  <transitions>
    <!-- 使用 Lepharist 印记打开接取提示页。 Using the Lepharist's Mark opens the accept prompt. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <use-item item-id="182213273"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_ASK_QUEST_ACCEPT_WINDOW"/>
      </after-commit>
    </transition>
    <!-- 接受接取。 Accept the quest. -->
    <transition source="unaccepted" target="started">
      <event>
        <dialog type="QUEST_ACTION" action="QUEST_ACCEPT_1"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 拒绝接取。 Refuse the quest. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="QUEST_ACTION" action="QUEST_REFUSE_1"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 与 801189 对话查看提示。 Talk to 801189 for the hint page. -->
    <transition source="started" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="801189" action="QUEST_SELECT"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT5"/>
      </after-commit>
    </transition>
    <!-- 选择奖励进入领奖页。 Select reward to reach the reward page. -->
    <transition source="started" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="801189" action="SELECT_QUEST_REWARD"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_SELECT_QUEST_REWARD_WINDOW1"/>
      </after-commit>
    </transition>
    <!-- 领奖页。 Reward page. -->
    <npc-complete npc-id="801189" source="reward" target="complete" fixed-reward-indices="0" actions="SELECTED_QUEST_REWARD1..SELECTED_QUEST_NOREWARD" complete-reward-index="0" finish="SELECTION_DIALOG">
      <preview actions="USE_OBJECT SELECT_QUEST_REWARD"/>
    </npc-complete>
  </transitions>
</quest-definition>
