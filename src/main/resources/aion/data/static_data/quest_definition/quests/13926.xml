  <transitions>
    <dialog type="NPC_START" npc-id="278517" source="unaccepted" target="started" selection-sources="unaccepted" start-page="SELECT_NONE"/>
    <!-- 击杀 0..8 累积计数，同时将 var0 保持为 0 自愈历史脏数据 -->
    <transition source="started" target="started" priority="1">
      <event>
        <kill-npc npc-ids="264526 264527 264528 264529 264530 264541 264542 264543 264544 264545 264830 264845 265130 265145 265430 265445 265730 265745 266030 266045"/>
      </event>
      <conditions>
        <variable-below field="var1" value="9"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="0"/>
        <increment-variable field="var1" delta="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <!-- 第 10 次击杀达成，var0 置 1 激活下一步客户端对话，进入 REWARD 状态 -->
    <transition source="started" target="reward" priority="0">
      <event>
        <kill-npc npc-ids="264526 264527 264528 264529 264530 264541 264542 264543 264544 264545 264830 264845 265130 265145 265430 265445 265730 265745 266030 266045"/>
      </event>
      <conditions>
        <variable-at-least field="var1" value="9"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
        <set-variable field="var1" value="10"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <!-- 满计数恢复路线：若处于 started 但击杀已满，允许与报告 NPC 对话报告并转移至 reward -->
    <transition source="started" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="278517" action="QUEST_SELECT"/>
      </event>
      <conditions>
        <variable-at-least field="var1" value="10"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <transition source="started" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="278517" action="SELECT_QUEST_REWARD"/>
      </event>
      <conditions>
        <variable-at-least field="var1" value="10"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_SELECT_QUEST_REWARD_WINDOW1"/>
      </after-commit>
    </transition>
    <!-- 领奖阶段：向报告 NPC 报告并领取奖励 -->
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="278517" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <npc-complete npc-id="278517" source="reward" target="complete" fixed-reward-indices="0 1" actions="SELECTED_QUEST_REWARD1..SELECTED_QUEST_NOREWARD" complete-reward-index="0" finish="SELECTION_DIALOG">
      <preview actions="USE_OBJECT SELECT_QUEST_REWARD" />
    </npc-complete>
  </transitions>
</quest-definition>
