<?xml version="1.0" encoding="UTF-8"?>
<quest-definition id="14252" version="1">
  <metadata name="[Dungeon/Group] Impeding the Beritra Legion" display-name-id="1801870" min-level="45" max-level="2147483647" category="QUEST" cannot-share="true">
    <races>
      <race id="ELYOS"/>
    </races>
    <rewards>
      <reward kind="EXP" id="0" amount="6242224"/>
    </rewards>
  </metadata>
  <progress>
    <!-- 客户端 quest_monster.csv：SECTION_0 是任务说明行索引（==0/==1/==2 三行击杀），
         SECTION_1 是当前行计数（每行 <1）；SECTION_2 仅保留旧 grid 存档的迁移标记。
         Client quest_monster.csv: SECTION_0 is the journal row index (three kill rows), SECTION_1 is
         the per-row counter (<1 each); SECTION_2 survives only as a legacy grid migration flag. -->
    <bit-field name="var0" offset="0" width="6" min="0" max="63" persistence="PERSISTENT" scope="LOCAL"/>
    <bit-field name="var1" offset="6" width="6" min="0" max="63" persistence="PERSISTENT" scope="LOCAL"/>
    <bit-field name="var2" offset="12" width="6" min="0" max="63" persistence="PERSISTENT" scope="LOCAL"/>
  </progress>
  <nodes>
    <node label="unaccepted" status="NONE"/>
    <node label="r0" status="START">
      <var name="var0" value="0"/>
      <var name="var1" value="0"/>
    </node>
    <node label="r1" status="START">
      <var name="var0" value="1"/>
      <var name="var1" value="0"/>
    </node>
    <node label="r2" status="START">
      <var name="var0" value="2"/>
      <var name="var1" value="0"/>
    </node>
    <!-- r3：第 3 行报告行，等待向 阿纳克萨 报告。 / r3: report row awaiting the NPC report. -->
    <node label="r3" status="START">
      <var name="var0" value="3"/>
      <var name="var1" value="1"/>
    </node>
    <node label="reward" status="REWARD">
      <var name="var0" value="3"/>
      <var name="var1" value="1"/>
    </node>
    <node label="complete" status="COMPLETE">
      <var name="var0" value="0"/>
      <var name="var1" value="0"/>
      <var name="var2" value="0"/>
    </node>
  </nodes>
  <transitions>
    <!-- 旧 grid 存档迁移（ENTER_WORLD）：旧 XML 用 var0/var1/var2 三维修 var0=A、var1=B、var2=C。 -->
    <!-- Legacy grid save migration on ENTER_WORLD: the previous XML used var0=A, var1=B, var2=C. -->
    <transition target="reward">
      <event>
        <enter-world/>
      </event>
      <conditions>
        <status-is status="REWARD"/>
        <variable-below field="var0" value="3"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="3"/>
        <set-variable field="var1" value="1"/>
        <set-variable field="var2" value="0"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <transition target="r3">
      <event>
        <enter-world/>
      </event>
      <conditions>
        <status-is status="START"/>
        <variable-at-least field="var0" value="1"/>
        <variable-at-least field="var1" value="1"/>
        <variable-at-least field="var2" value="1"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="3"/>
        <set-variable field="var1" value="1"/>
        <set-variable field="var2" value="0"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <transition target="r2">
      <event>
        <enter-world/>
      </event>
      <conditions>
        <status-is status="START"/>
        <variable-at-least field="var0" value="1"/>
        <variable-at-least field="var1" value="1"/>
        <variable-below field="var2" value="1"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="2"/>
        <set-variable field="var1" value="0"/>
        <set-variable field="var2" value="0"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <transition target="r0">
      <event>
        <enter-world/>
      </event>
      <conditions>
        <status-is status="START"/>
        <variable-at-least field="var1" value="1"/>
        <variable-below field="var0" value="1"/>
      </conditions>
      <actions>
        <set-variable field="var1" value="0"/>
        <set-variable field="var2" value="0"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <transition target="r0">
      <event>
        <enter-world/>
      </event>
      <conditions>
        <status-is status="START"/>
        <variable-below field="var0" value="1"/>
        <variable-below field="var1" value="1"/>
        <variable-at-least field="var2" value="1"/>
      </conditions>
      <actions>
        <set-variable field="var2" value="0"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <dialog type="NPC_START" npc-id="805736" source="unaccepted" target="r0" selection-sources="unaccepted r0" start-page="SELECT_NONE"/>
    <!-- 第 1 行：中央控制室的纳迦工程师（+ 洞穴加强版）。 / Row 1: the Naga engineer in the central control room. -->
