      <actions>
        <set-variable field="var0" value="1"/>
        <set-variable field="var1" value="0"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <!-- 第 2 行：破坏全部次元门增强装置后消灭巴卡尔马。 / Row 2: the Drakan fire boss. -->
    <transition source="r1" target="r2">
