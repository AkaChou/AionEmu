<?xml version="1.0" encoding="UTF-8"?>
<quest-definition id="25545" version="1">
  <metadata name="[Learn Minion] Precious Comrade Minion" display-name-id="1803439" min-level="66" max-level="2147483647" category="SIGNIFICANT" cannot-share="true" cannot-giveup="true">
    <races>
      <race id="ASMODIANS"/>
    </races>
    <work-items>
      <item id="190080011" count="1"/>
    </work-items>
    <rewards>
      <reward kind="ITEM" id="190080012" amount="1"/>
    </rewards>
  </metadata>
  <progress>
    <bit-field name="var0" offset="0" width="6" min="0" max="63" persistence="PERSISTENT" scope="LOCAL"/>
  </progress>
  <nodes>
    <node label="unaccepted" status="NONE">
      <var name="var0" value="0"/>
    </node>
    <node label="started" status="START">
      <var name="var0" value="0"/>
    </node>
    <node label="reward" status="REWARD">
      <var name="var0" value="1"/>
    </node>
    <node label="complete" status="COMPLETE">
      <var name="var0" value="0"/>
    </node>
  </nodes>
  <transitions>
    <!-- 天族镜像任务的阿斯莫德分支：旧 handler `_25545A_New_Comrade_For_A_Archdaeva` 在
         ACCEPT_QUEST_SIMPLE 发放 190080011（quest_25545a 下级宠物精灵契约书），typed XML 迁移同样丢失。
         Asmodian mirror of the Elyos contract: the legacy handler `_25545A_New_Comrade_For_A_Archdaeva`
         granted 190080011 (quest_25545a) on ACCEPT_QUEST_SIMPLE and the typed XML migration dropped it too. -->
    <dialog type="NPC_START" npc-id="835515" source="unaccepted" target="started" selection-sources="unaccepted started" start-page="SELECT_NONE">
      <accept-actions>
        <give-item item-id="190080011" count="1"/>
      </accept-actions>
    </dialog>
    <dialog type="NPC_REPORT" npc-id="835515" source="started" target="reward" page="DEFAULT_SUCCESS"/>
    <!-- 领奖态入口页：MinionService 在使用召唤契约后把任务推进到 REWARD(var0=1)，玩家随后在 835515 上
         选择任务行（客户端动作 31）时必须拿回 select_success(10002)，其按钮 1009 再打开奖励窗口。
         Reward-state entry page: MinionService advances the quest to REWARD (var0=1) when the summon contract
         is used, so a later quest-row selection (client action 31) on 835515 must return select_success(10002);
         its 1009 button then opens the reward window. -->
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="835515" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <!-- 旧存档自愈：本定义曾把 reward 投影写成 var0=0，而 MinionService 写入的是召唤完成行 1；进入世界时
         按 reward 节点投影把错位步数改写为 1 并同步给客户端。
         Legacy save recovery: this definition used to project var0=0 while MinionService writes the summon
         completion row 1; entering the world rewrites the misplaced packed step to the reward projection and
         re-syncs the client. -->
    <transition target="reward">
      <event>
        <enter-world/>
      </event>
      <conditions>
        <status-is status="REWARD"/>
        <variable-is field="var0" value="0"/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <npc-complete npc-id="835515" source="reward" target="complete" fixed-reward-indices="0" actions="SELECTED_QUEST_REWARD1..SELECTED_QUEST_NOREWARD" complete-reward-index="0" finish="SELECTION_DIALOG">
      <preview actions="USE_OBJECT SELECT_QUEST_REWARD"/>
    </npc-complete>
    <transition source="started" target="reward">
      <event>
        <use-item item-id="190080011"/>
      </event>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_SELECT_QUEST_REWARD_WINDOW1"/>
      </after-commit>
    </transition>
  </transitions>
</quest-definition>
