      <reward kind="EXP" id="0" amount="5647915"/>
      <reward kind="AP" id="0" amount="2000"/>
      <reward kind="ITEM" id="161000004" amount="5"/>
    </rewards>
    <drops>
      <drop npc-id="700948" item-id="182205691" chance="100" each-member="true" collecting-step="0"/>
    </drops>
  </metadata>
  <progress>
    <bit-field name="var0" offset="0" width="3" min="0" max="2" persistence="PERSISTENT" scope="LOCAL"/>
  </progress>
  <nodes>
    <node label="unaccepted" status="NONE">
      <var name="var0" value="0"/>
    </node>
    <node label="started" status="START">
      <var name="var0" value="0"/>
    </node>
    <node label="s1" status="START">
      <var name="var0" value="1"/>
    </node>
    <node label="s2" status="START">
      <var name="var0" value="2"/>
    </node>
    <node label="reward" status="REWARD">
      <var name="var0" value="2"/>
    </node>
    <node label="complete" status="COMPLETE">
      <var name="var0" value="2"/>
    </node>
  </nodes>
  <transitions>
    <!-- 接取介绍。 Quest-start intro dialog. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799226" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT_NONE"/>
      </after-commit>
    </transition>
    <!-- 接受任务。 Accept the quest. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799226" action="ASK_QUEST_ACCEPT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_ASK_QUEST_ACCEPT_WINDOW"/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799226" action="QUEST_ACCEPT_1"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="QUEST_ACCEPT_1"/>
      </after-commit>
    </transition>
    <!-- 拒绝任务。 Decline the quest. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799226" action="QUEST_REFUSE_1"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="QUEST_REFUSE_1"/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799226" actions="QUEST_REFUSE_2 QUEST_REFUSE_SIMPLE"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- Yorgen 对话与推进。 Dialog and advance with Yorgen. -->
    <transition source="started" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799403" action="QUEST_SELECT"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT1"/>
      </after-commit>
    </transition>
    <transition source="started" target="s1">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799403" action="SETPRO1"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 获得 Balaur Weapon 后推进。 Advance after obtaining the Balaur Weapon. -->
    <transition source="s1" target="s2">
      <event>
        <get-item item-id="182205691"/>
      </event>
      <conditions>
        <variable-is field="var0" value="1"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="2"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <!-- 与 Balaur Weapon 交互关闭窗口。 Interacting with the Balaur Weapon closes the window. -->
    <transition source="s1" target="s1">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="700948" action="USE_OBJECT"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <transition source="s2" target="s2">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="700948" action="USE_OBJECT"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 击杀 Captain Zanata 进入奖励阶段。 Killing Captain Zanata enters the reward stage. -->
    <transition source="s2" target="reward">
      <event>
        <kill-npc npc-id="216886"/>
      </event>
      <conditions>
        <variable-is field="var0" value="2"/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <!-- 奖励阶段对话。 Reward-stage dialog. -->
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799226" action="USE_OBJECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799226" action="SELECT_QUEST_REWARD"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_SELECT_QUEST_REWARD_WINDOW1"/>
      </after-commit>
    </transition>
    <!-- 选择奖励并完成。 Choose reward and complete. -->
    <transition source="reward" target="complete">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799226" actions="SELECTED_QUEST_REWARD1..SELECTED_QUEST_NOREWARD"/>
      </event>
      <actions>
        <grant-reward kind="GOLD" id="0" amount="225000" amount-mode="QUEST_BASE"/>
        <grant-reward kind="EXP" id="0" amount="5647915" amount-mode="QUEST_BASE"/>
        <grant-reward kind="AP" id="0" amount="2000" amount-mode="QUEST_BASE"/>
        <grant-reward kind="ITEM" id="161000004" amount="5"/>
        <complete-quest reward-index="0"/>
      </actions>
      <after-commit>
        <refresh-player-stats/>
        <sync-quest-state mode="COMPLETION"/>
        <dialog type="SHOW_SELECTION_PAGE" page="SELECT_QUEST"/>
      </after-commit>
    </transition>
    <transition source="s1" target="s1">
      <event>
        <can-act template-id="700948" action-type="ACTION_ITEM_USE"/>
      </event>
    </transition>
    <transition source="s2" target="s2">
      <event>
        <can-act template-id="700948" action-type="ACTION_ITEM_USE"/>
      </event>
    </transition>
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799226" action="SELECT1_1"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT1_1"/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799226" action="FINISH_DIALOG"/>
      </event>
      <after-commit>
        <dialog type="SHOW_SELECTION_PAGE" page="SELECT_QUEST"/>
      </after-commit>
    </transition>
    <transition source="started" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799226" action="FINISH_DIALOG"/>
      </event>
      <after-commit>
        <dialog type="SHOW_SELECTION_PAGE" page="SELECT_QUEST"/>
      </after-commit>
    </transition>
  </transitions>
</quest-definition>
