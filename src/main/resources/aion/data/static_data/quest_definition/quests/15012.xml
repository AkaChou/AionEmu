      <event>
        <dialog type="TALK_TO_NPC" npc-id="804875" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <transition source="started" target="reward" priority="0">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="804875" action="SELECT_QUEST_REWARD"/>
      </event>
      <conditions>
        <has-item item-id="182215667" count="5"/>
      </conditions>
      <actions>
        <remove-item item-id="182215667" count="5"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_SELECT_QUEST_REWARD_WINDOW1"/>
      </after-commit>
    </transition>
    <transition source="started" target="started" priority="1">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="804875" action="SELECT_QUEST_REWARD"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="CHECK_USER_ITEM_FAIL"/>
      </after-commit>
    </transition>
    <transition source="started" target="started">
