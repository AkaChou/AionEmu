<?xml version="1.0" encoding="UTF-8"?>
<quest-definition id="13831" version="1">
  <metadata name="Pelias' Aid" display-name-id="1801120" min-level="40" max-level="2147483647" category="PRIMARY" cannot-share="true" use-class-reward="1">
    <races>
