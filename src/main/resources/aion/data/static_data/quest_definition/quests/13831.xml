    </races>
    <repeat max-repeat-count="1" cooldown-seconds="0" daily="false" weekly="false"/>
    <work-items>
      <item id="182216119" count="1"/>
    </work-items>
    <rewards>
      <reward kind="EXP" id="0" amount="337255"/>
    </rewards>
    <class-rewards>
      <class id="FIGHTER"><reward kind="ITEM" id="140001111" amount="1"/></class>
      <class id="KNIGHT"><reward kind="ITEM" id="140001128" amount="1"/></class>
      <class id="RANGER"><reward kind="ITEM" id="140001171" amount="1"/></class>
      <class id="ASSASSIN"><reward kind="ITEM" id="140001142" amount="1"/></class>
      <class id="WIZARD"><reward kind="ITEM" id="140001186" amount="1"/></class>
      <class id="ELEMENTALIST"><reward kind="ITEM" id="140001203" amount="1"/></class>
      <class id="PRIEST"><reward kind="ITEM" id="140001240" amount="1"/></class>
      <class id="CHANTER"><reward kind="ITEM" id="140001220" amount="1"/></class>
      <class id="GUNSLINGER"><reward kind="ITEM" id="140001254" amount="1"/></class>
      <class id="SONGWEAVER"><reward kind="ITEM" id="140001290" amount="1"/></class>
      <class id="AETHERTECH"><reward kind="ITEM" id="140001275" amount="1"/></class>
    </class-rewards>
  </metadata>
  <progress>
    <bit-field name="var0" offset="0" width="2" min="0" max="1" persistence="PERSISTENT" scope="LOCAL"/>
  </progress>
  <nodes>
    <node label="unaccepted">
      <project status="NONE">
        <vars>
          <var name="var0" value="0"/>
        </vars>
      </project>
    </node>
    <node label="started">
      <project status="START">
        <vars>
          <var name="var0" value="0"/>
        </vars>
      </project>
    </node>
    <node label="reward">
      <project status="REWARD">
        <vars>
          <var name="var0" value="1"/>
        </vars>
      </project>
    </node>
    <node label="complete">
      <project status="COMPLETE">
        <vars>
          <var name="var0" value="0"/>
        </vars>
      </project>
    </node>
  </nodes>
  <transitions>
    <!-- 40 级升阶时自动接取并发放任务物品（等级/种族由 start-eligible 依据 metadata 检查）。
         Auto-accept on reaching level 40 and grant the quest item (level/race checked by start-eligible). -->
    <transition source="unaccepted" target="started">
      <event>
        <level-up/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <actions>
        <give-item item-id="182216119" count="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <!-- 使用任务物品后进入领奖。Using the quest item advances to reward. -->
    <transition source="started" target="reward">
      <event>
        <use-item item-id="182216119"/>
      </event>
      <actions>
        <set-variable field="var0" value="1"/>
        <set-status status="REWARD"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <!-- 已持有任务物品的玩家进入圣天城时不重复发放（旧 handler 的 <1 检查）。
         Entering Sanctum while already holding the item does nothing (legacy <1 guard). -->
    <transition source="started" target="started" priority="0">
      <event>
        <enter-world/>
      </event>
      <conditions>
        <world-is world-id="110010000"/>
        <has-item item-id="182216119" count="1"/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <!-- 缺失任务物品的玩家进入圣天城时补发。Re-grant the lost item on entering Sanctum. -->
    <transition source="started" target="started" priority="1">
      <event>
        <enter-world/>
      </event>
      <conditions>
        <world-is world-id="110010000"/>
      </conditions>
      <actions>
        <give-item item-id="182216119" count="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <!-- 领奖：打开任务文本。Reward dialog: open quest text. -->
    <transition source="reward" target="reward">
      <event>
        <talk-to-npc npc-id="203711" dialog-id="-1"/>
      </event>
      <after-commit>
        <show-quest-dialog dialog-id="10002"/>
      </after-commit>
    </transition>
    <!-- 领奖：打开奖励选择。Reward dialog: open reward selection. -->
    <transition source="reward" target="reward">
      <event>
        <talk-to-npc npc-id="203711" dialog-id="1009"/>
      </event>
      <after-commit>
        <show-quest-dialog dialog-id="5"/>
      </after-commit>
    </transition>
    <!-- 领奖：选择奖励并完成（8..23 覆盖 SELECTED_QUEST_REWARD1..15 与 SELECT_NO_REWARD）。
         Reward claim: finish with the chosen reward (8..23 covers reward slots and no-reward). -->
    <transition source="reward" target="complete">
      <event>
        <talk-to-npc npc-id="203711" dialog-ids="8..23"/>
      </event>
      <actions>
        <!-- 完成时回收全部任务工作物品（旧 finishQuest 的清理语义）。Reclaim all quest work items on completion. -->
        <remove-item item-id="182216119" count="ALL"/>
        <grant-reward kind="EXP" id="0" amount="337255" amount-mode="QUEST_BASE"/>
        <complete-quest reward-index="0"/>
      </actions>
      <after-commit>
        <refresh-player-stats/>
        <sync-quest-state mode="COMPLETION"/>
        <show-quest-selection-dialog dialog-id="10"/>
      </after-commit>
    </transition>
  </transitions>
</quest-definition>
