      <after-commit>
        <show-quest-dialog dialog-id="4762"/>
      </after-commit>
    </transition>
    <!-- 接受接取。 Accept the quest. -->
    <transition source="unaccepted" target="started">
      <event>
        <talk-to-npc npc-id="799522" dialog-ids="1002 20000"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 拒绝接取。 Refuse the quest. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <talk-to-npc npc-id="799522" dialog-ids="1003 20001"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 掉落源 NPC 对话无操作。 Drop-source NPC dialog is a no-op. -->
    <transition source="started" target="started">
      <event>
        <talk-to-npc npc-id="700954"/>
      </event>
    </transition>
    <!-- 大锅对话显示提示。 Cauldron dialog shows the prompt. -->
    <transition source="started" target="started">
      <event>
        <talk-to-npc npc-id="730359" dialog-id="-1"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <after-commit>
        <show-quest-dialog dialog-id="1011"/>
      </after-commit>
    </transition>
    <!-- 收集物齐全时显示成功页。 Collected items sufficient shows the success page. -->
    <transition source="started" target="started" priority="0">
      <event>
        <talk-to-npc npc-id="730359" dialog-id="39"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
        <has-item item-id="182212010" count="5"/>
      </conditions>
      <after-commit>
        <show-quest-dialog dialog-id="1352"/>
      </after-commit>
    </transition>
    <!-- 收集物不足时提示。 Missing collectibles shows the fail prompt. -->
    <transition source="started" target="started" priority="1">
      <event>
        <talk-to-npc npc-id="730359" dialog-id="39"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <after-commit>
        <show-quest-dialog dialog-id="10001"/>
      </after-commit>
    </transition>
    <!-- 领取工作物品。 Take the work item. -->
    <transition source="started" target="started">
      <event>
        <talk-to-npc npc-id="730359" dialog-id="10001"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <actions>
        <give-item item-id="182212011" count="1"/>
      </actions>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 获得工作物品后进入领奖。 Get the work item to reach reward. -->
    <transition source="started" target="reward">
      <event>
        <get-item item-id="182212011"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <!-- 奖励 NPC 打开奖励页。 Reward NPC opens the reward page. -->
    <transition source="reward" target="reward">
      <event>
        <talk-to-npc npc-id="790000" dialog-id="-1"/>
      </event>
      <after-commit>
        <show-quest-dialog dialog-id="10002"/>
      </after-commit>
    </transition>
    <npc-complete npc-id="790000" source="reward" target="complete" fixed-reward-indices="0 1 2" dialog-ids="8..23" complete-reward-index="0" preview-dialog-ids="1009" finish="SELECTION_DIALOG"/>
    <transition source="started" target="started"><event><can-act template-id="700954" action-type="ACTION_ITEM_USE"/></event></transition>
    <transition source="started" target="started"><event><can-act template-id="730359" action-type="ACTION_ITEM_USE"/></event></transition>
  </transitions>
