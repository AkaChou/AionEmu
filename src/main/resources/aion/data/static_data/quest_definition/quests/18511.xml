<?xml version="1.0" encoding="UTF-8"?>
<quest-definition id="18511" version="1">
  <metadata name="Out Of The Past" display-name-id="1135011" min-level="16" max-level="2147483647" category="IMPORTANT" cannot-share="true">
    <races>
      <race id="ELYOS"/>
    </races>
    <repeat max-repeat-count="1" cooldown-seconds="0" daily="false" weekly="false"/>
    <items>
      <item id="182212010" count="5"/>
    </items>
    <work-items>
      <item id="182212011" count="1"/>
    </work-items>
    <rewards>
      <reward kind="GOLD" id="0" amount="33480"/>
      <reward kind="EXP" id="0" amount="75359"/>
      <reward kind="ITEM" id="186000002" amount="3"/>
    </rewards>
    <drops>
      <drop npc-id="700954" item-id="182212010" chance="100" each-member="true" collecting-step="0"/>
    </drops>
    <start-conditions>
      <condition type="finished" quest-id="18507"/>
    </start-conditions>
  </metadata>
  <progress>
    <bit-field name="var0" offset="0" width="2" min="0" max="1" persistence="PERSISTENT" scope="LOCAL"/>
  </progress>
  <nodes>
    <node label="unaccepted" status="NONE">
      <var name="var0" value="0"/>
    </node>
    <node label="started" status="START">
      <var name="var0" value="0"/>
    </node>
    <node label="reward" status="REWARD">
      <var name="var0" value="1"/>
    </node>
    <node label="complete" status="COMPLETE"/>
  </nodes>
  <transitions>
    <!-- 未接取时对话显示提示。 Unaccepted dialog shows the prompt. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799522" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT_NONE"/>
      </after-commit>
    </transition>
    <!-- 接受接取。 Accept the quest. -->
    <transition source="unaccepted" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799522" actions="QUEST_ACCEPT_1 QUEST_ACCEPT_SIMPLE"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 拒绝接取。 Refuse the quest. -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="799522" actions="QUEST_REFUSE_1 QUEST_REFUSE_SIMPLE"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 掉落源 NPC 对话无操作。 Drop-source NPC dialog is a no-op. -->
    <transition source="started" target="started">
      <event>
        <talk-to-npc npc-id="700954"/>
      </event>
    </transition>
    <!-- 大锅对话显示提示。 Cauldron dialog shows the prompt. -->
    <transition source="started" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="730359" action="USE_OBJECT"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT1"/>
      </after-commit>
    </transition>
    <!-- 收集物齐全时显示成功页。 Collected items sufficient shows the success page. -->
    <transition source="started" target="started" priority="0">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="730359" action="CHECK_USER_HAS_QUEST_ITEM"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
        <has-item item-id="182212010" count="5"/>
      </conditions>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT2"/>
      </after-commit>
    </transition>
    <!-- 收集物不足时提示。 Missing collectibles shows the fail prompt. -->
    <transition source="started" target="started" priority="1">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="730359" action="CHECK_USER_HAS_QUEST_ITEM"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="CHECK_USER_ITEM_FAIL"/>
      </after-commit>
    </transition>
    <!-- 领取工作物品。 Take the work item. -->
    <transition source="started" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="730359" action="SETPRO2"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <actions>
        <give-item item-id="182212011" count="1"/>
      </actions>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 获得工作物品后进入领奖。 Get the work item to reach reward. -->
    <transition source="started" target="reward">
      <event>
        <get-item item-id="182212011"/>
      </event>
      <conditions>
        <variable-is field="var0" value="0"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <!-- 奖励 NPC 打开奖励页。 Reward NPC opens the reward page. -->
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="790000" action="USE_OBJECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <npc-complete npc-id="790000" source="reward" target="complete" fixed-reward-indices="0 1 2" actions="SELECTED_QUEST_REWARD1..SELECTED_QUEST_NOREWARD" complete-reward-index="0" finish="SELECTION_DIALOG">
      <preview actions="SELECT_QUEST_REWARD"/>
    </npc-complete>
    <transition source="started" target="started">
      <event>
        <can-act template-id="700954" action-type="ACTION_ITEM_USE"/>
      </event>
    </transition>
    <transition source="started" target="started">
      <event>
        <can-act template-id="730359" action-type="ACTION_ITEM_USE"/>
      </event>
    </transition>
  </transitions>
</quest-definition>
