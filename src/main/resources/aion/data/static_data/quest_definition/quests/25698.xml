<?xml version="1.0" encoding="UTF-8"?>
<quest-definition id="25698" version="1">
  <metadata name="[Weekly] Shadows after the Territory of Spiritus Base" display-name-id="1803881" min-level="70" max-level="2147483647" category="QUEST">
    <races>
      <race id="ASMODIANS"/>
    </races>
    <repeat max-repeat-count="255" cooldown-seconds="0" daily="false" weekly="true" cycles="WED"/>
    <rewards>
      <reward kind="GOLD" id="0" amount="1500000"/>
      <reward kind="EXP" id="0" amount="53023500"/>
      <reward kind="ITEM" id="186000500" amount="3"/>
    </rewards>
  </metadata>
  <progress>
    <bit-field name="var0" offset="0" width="6" min="0" max="63" persistence="PERSISTENT" scope="LOCAL"/>
    <bit-field name="var1" offset="6" width="6" min="0" max="5" persistence="PERSISTENT" scope="LOCAL"/>
  </progress>
  <nodes>
    <node label="unaccepted" status="NONE">
      <var name="var0" value="0"/>
      <var name="var1" value="0"/>
    </node>
    <node label="started" status="START"/>
    <node label="reward" status="REWARD">
      <var name="var0" value="1"/>
      <var name="var1" value="5"/>
    </node>
    <node label="complete" status="COMPLETE">
      <var name="var0" value="0"/>
      <var name="var1" value="0"/>
    </node>
  </nodes>
  <transitions>
    <dialog type="NPC_START" npc-id="806804" source="unaccepted" target="started" selection-sources="unaccepted" start-page="SELECT_NONE"/>
    <!-- 击杀 0..3 累积计数，同时将 var0 保持为 0 自愈历史脏数据 -->
    <transition source="started" target="started" priority="1">
      <event>
        <kill-npc npc-ids="885487 885488 885489 885490"/>
      </event>
      <conditions>
        <variable-below field="var1" value="4"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="0"/>
        <increment-variable field="var1" delta="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <!-- 第 5 次击杀达成，var0 置 1 激活下一步客户端对话，进入 REWARD 状态 -->
    <transition source="started" target="reward" priority="0">
      <event>
        <kill-npc npc-ids="885487 885488 885489 885490"/>
      </event>
      <conditions>
        <variable-at-least field="var1" value="4"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
        <set-variable field="var1" value="5"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <!-- 满计数恢复路线：若处于 started 但击杀已满，允许与报告 NPC 对话报告并转移至 reward -->
    <transition source="started" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="806804" action="QUEST_SELECT"/>
      </event>
      <conditions>
        <variable-at-least field="var1" value="5"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <transition source="started" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="806804" action="SELECT_QUEST_REWARD"/>
      </event>
      <conditions>
        <variable-at-least field="var1" value="5"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_SELECT_QUEST_REWARD_WINDOW1"/>
      </after-commit>
    </transition>
    <!-- 领奖阶段：向报告 NPC 报告并领取奖励 -->
    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="806804" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <transition source="reward" target="complete">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="806804" actions="SELECTED_QUEST_REWARD1..SELECTED_QUEST_NOREWARD" />
      </event>
      <actions>
        <grant-reward kind="GOLD" id="0" amount="1500000" amount-mode="QUEST_BASE" />
        <grant-reward kind="EXP" id="0" amount="53023500" amount-mode="QUEST_BASE" />
        <grant-reward kind="ITEM" id="186000500" amount="3" />
        <complete-quest reward-index="0" />
      </actions>
      <after-commit>
        <refresh-player-stats />
        <sync-quest-state mode="COMPLETION" />
        <dialog type="SHOW_SELECTION_PAGE" page="SELECT_QUEST" />
      </after-commit>
    </transition>
  </transitions>
</quest-definition>
