<?xml version="1.0" encoding="UTF-8"?>
<!--
  51019 [活动/每日]巧克力塔的装饰 (Chocolate Tower Decoration, Asmodian)
  Runtime: collect 3 Chocolate Tower Decoration (182215178), report to 202549 for reward; prerequisite quest 51010 finished. Drops are handled by event system at runtime (no npc-id mapping in retail data).
  运行语义: 收集 3 个巧克力塔装饰(182215178)后向 202549 交付领取奖励; 前置任务 51010 已完成。掉落由活动系统运行时下发(真实无 npc-id 可映射)。
  真实 authority: 58Server-new/Map/XML/quest.xml (51019 块: min 9/collect quest_51011a x3/work quest_51013a/前置 Q51010:1/奖励 188051769+160010208+160010209); Quest.pak quest_monster.csv 51019,Progress(0),quest_51011a,questItemDropMonster,valentineevent_brownie_solo; client_strings_quest.xml STR_QUEST_NAME_Q51019 → nameId 1150066; legacy event.xml <monster_hunt start_npc_ids="202549" id="51019">; 同族 50019.xml 已迁移先例。
-->
<quest-definition id="51019" version="1">
  <metadata name="[活动/每日]巧克力塔的装饰" display-name-id="1150066" min-level="9" max-level="2147483647" category="EVENT" cannot-share="true">
    <races>
      <race id="ASMODIANS"/>
    </races>
    <repeat max-repeat-count="255" cooldown-seconds="0" daily="true" weekly="false" cycles="ALL"/>
    <prerequisites>
      <quest id="51010" reward-mode="1"/>
    </prerequisites>
    <items>
      <item id="182215178" count="3"/>
    </items>
    <work-items>
      <item id="182215180" count="1"/>
    </work-items>
    <rewards>
      <reward kind="ITEM" id="188051769" amount="1"/>
      <reward kind="ITEM" id="160010208" amount="1"/>
      <reward kind="ITEM" id="160010209" amount="1"/>
    </rewards>
    <drops>
      <drop npc-id="219315" item-id="182215178" chance="100" each-member="true" collecting-step="0"/>
    </drops>
  </metadata>
  <progress>
    <bit-field name="var0" offset="0" width="6" min="0" max="63" persistence="PERSISTENT" scope="LOCAL"/>
  </progress>
  <nodes>
    <node label="unaccepted" status="NONE">
      <var name="var0" value="0"/>
    </node>
    <node label="started" status="START">
      <var name="var0" value="0"/>
    </node>
    <node label="s1" status="START">
      <var name="var0" value="1"/>
    </node>
    <node label="reward" status="REWARD">
      <var name="var0" value="2"/>
    </node>
    <node label="complete" status="COMPLETE">
      <var name="var0" value="0"/>
    </node>
  </nodes>
  <transitions>
    <!-- QE-051 三行阶梯（批次 35）：客户端 quest_summary 三行（槽位 %0/%3/%6）——行 0“消灭情人节布朗尼、
         收集巧克力交给术古”([%collectitem])、行 1“在巧克力塔上使用巧克力装饰”、行 2“和术古对话”。
         页链：select_none(accept) / select1 的 CHECK_USER_HAS_QUEST_ITEM -> check_user_item_ok 的 **SETPRO2** /
         check_user_item_fail 的 FINISH_DIALOG / select_success 的 SELECT_QUEST_REWARD。旧定义把交付直接送到
         reward(0)，巧克力塔物件 701467 从未接进 IR，行 1 永远拿不到状态。
         Row ladder repair (batch 35): the client owns three rows (hand in the collected chocolate, decorate the
         tower, report back) while the migrated definition jumped straight from the item report to REWARD. -->
    <transition target="reward">
      <event>
        <enter-world/>
      </event>
      <conditions>
        <status-is status="REWARD"/>
        <variable-is field="var0" value="0"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="2"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <transition target="reward">
      <event>
        <enter-world/>
      </event>
      <conditions>
        <status-is status="REWARD"/>
        <variable-is field="var0" value="1"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="2"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
      </after-commit>
    </transition>
    <!-- 接取：起始对话 / start dialogs -->
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT_NONE"/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="ASK_QUEST_ACCEPT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SHOW_ASK_QUEST_ACCEPT_WINDOW"/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="QUEST_ACCEPT_1"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="QUEST_ACCEPT_1"/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="QUEST_ACCEPT_SIMPLE"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <close-dialog/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="SETPRO1"/>
      </event>
      <conditions>
        <start-eligible/>
      </conditions>
      <after-commit>
        <sync-quest-state mode="VISIBILITY_REFRESH"/>
        <close-dialog/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" actions="QUEST_REFUSE_1 QUEST_REFUSE_2 QUEST_REFUSE_SIMPLE"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <transition source="unaccepted" target="unaccepted">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="FINISH_DIALOG"/>
      </event>
      <after-commit>
        <dialog type="SHOW_SELECTION_PAGE" page="SELECT_QUEST"/>
      </after-commit>
    </transition>
    <!-- 交任务：校验收集物 / turn-in: check collected items -->
    <transition source="started" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="SELECT1"/>
      </after-commit>
    </transition>
        <!-- 行 0：交付 3 个收集巧克力（客户端 select1 的“拿出巧克力”按钮 = CHECK_USER_HAS_QUEST_ITEM），
         任务书切到行 1。 / Row 0: hand in the collected chocolate, moving the journal to row 1. -->
    <transition source="started" target="s1">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="CHECK_USER_HAS_QUEST_ITEM"/>
      </event>
      <conditions>
        <has-item item-id="182215178" count="3"/>
      </conditions>
      <actions>
        <remove-item item-id="182215178" count="3"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="CHECK_USER_ITEM_OK"/>
      </after-commit>
    </transition>
    <!-- check_user_item_ok 页的确认按钮（SETPRO2）：此刻已在行 1，就地关闭对话框，不再额外推进。
         Confirm button of check_user_item_ok: stays on row 1 and just closes the dialog. -->
    <transition source="s1" target="s1">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="SETPRO2"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 行 1 -> 行 2：在巧克力塔物件上使用巧克力装饰（活动系统负责刷塔）。 / Row 1 -> row 2: decorate the tower. -->
    <transition source="s1" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="701467" action="USE_OBJECT"/>
      </event>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <close-dialog/>
      </after-commit>
    </transition>
    <!-- 防呆：若活动塔未刷出，直接找术古对话也能进入领奖行，避免卡在行 1。 -->
    <transition source="s1" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <!-- 奖励：发放并完成 / reward: grant and complete -->
    <npc-complete npc-id="202549" source="reward" target="complete" fixed-reward-indices="0 1 2" actions="SELECTED_QUEST_REWARD1..SELECTED_QUEST_NOREWARD" complete-reward-index="0" finish="SELECTION_DIALOG">
      <preview actions="USE_OBJECT SELECT_QUEST_REWARD"/>
    </npc-complete>

    <transition source="reward" target="reward">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="QUEST_SELECT"/>
      </event>
      <after-commit>
        <dialog type="SHOW_QUEST_PAGE" page="DEFAULT_SUCCESS"/>
      </after-commit>
    </transition>
    <!-- 客户端 check_user_item_fail 页：物品不足时显示确认，FINISH_DIALOG 关闭。 -->
    <transition source="started" target="started">
      <event>
        <dialog type="TALK_TO_NPC" npc-id="202549" action="FINISH_DIALOG"/>
      </event>
      <after-commit>
        <close-dialog/>
      </after-commit>
    </transition></transitions>
</quest-definition>
