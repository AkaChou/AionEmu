    <transition source="started" target="started">
      <event>
        <kill-npc npc-ids="218972 218974 218975 218976 218979 218977"/>
      </event>
      <conditions>
        <variable-below field="var0" value="15"/>
      </conditions>
      <actions>
        <increment-variable field="var0" delta="1"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
      </after-commit>
    </transition>
    <!-- 击杀期间的 NPC 对话。 NPC dialog while hunting. -->
    <transition source="started" target="started">
      <event>
        <talk-to-npc npc-id="205233" dialog-id="31"/>
      </event>
      <conditions>
        <variable-below field="var0" value="16"/>
      </conditions>
      <after-commit>
        <show-quest-dialog dialog-id="1352"/>
      </after-commit>
    </transition>
    <!-- 杀满 15 只后推进。 Advance after all 15 kills. -->
    <transition source="started" target="s16">
      <event>
        <talk-to-npc npc-id="205233" dialog-id="10001"/>
      </event>
      <conditions>
        <variable-is field="var0" value="15"/>
      </conditions>
      <actions>
        <set-variable field="var0" value="16"/>
      </actions>
      <after-commit>
        <sync-quest-state mode="PACKET_ONLY"/>
        <close-dialog/>
