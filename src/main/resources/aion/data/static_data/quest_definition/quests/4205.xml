        <talk-to-npc npc-id="204792" dialog-id="31"/>
      </event>
      <after-commit>
        <show-quest-dialog dialog-id="1693"/>
      </after-commit>
    </transition>
    <transition source="s16" target="reward">
      <event>
        <talk-to-npc npc-id="204792" dialog-id="10255"/>
      </event>
      <after-commit>
        <sync-quest-state mode="LEVEL_AND_VISIBILITY_REFRESH"/>
        <close-dialog/>
