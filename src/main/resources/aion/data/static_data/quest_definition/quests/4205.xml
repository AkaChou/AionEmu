      <actions>
        <grant-reward kind="GOLD" id="0" amount="175040" amount-mode="QUEST_BASE"/>
        <grant-reward kind="EXP" id="0" amount="1936350" amount-mode="QUEST_BASE"/>
        <grant-reward kind="ITEM" id="162000048" amount="3"/>
