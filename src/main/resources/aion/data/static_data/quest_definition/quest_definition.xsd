<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="status"><xs:restriction base="xs:string">
    <xs:enumeration value="NONE"/><xs:enumeration value="START"/><xs:enumeration value="REWARD"/>
    <xs:enumeration value="COMPLETE"/><xs:enumeration value="LOCKED"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="persistence"><xs:restriction base="xs:string"><xs:enumeration value="PERSISTENT"/><xs:enumeration value="MEMORY"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="scope"><xs:restriction base="xs:string"><xs:enumeration value="LOCAL"/><xs:enumeration value="SHARED"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="drop-scope"><xs:restriction base="xs:string"><xs:enumeration value="NONE"/><xs:enumeration value="GROUP"/><xs:enumeration value="ALLIANCE"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="timer-scope"><xs:restriction base="xs:string"><xs:enumeration value="PLAYER_QUEST"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="timer-persistence"><xs:restriction base="xs:string"><xs:enumeration value="SESSION"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="timer-overwrite"><xs:restriction base="xs:string"><xs:enumeration value="REPLACE"/><xs:enumeration value="KEEP_EXISTING"/><xs:enumeration value="FAIL_IF_RUNNING"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="timer-delivery"><xs:restriction base="xs:string"><xs:enumeration value="AT_MOST_ONCE"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="npc-emotion"><xs:restriction base="xs:string"><xs:enumeration value="START_EMOTE2"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="player-emotion"><xs:restriction base="xs:string"><xs:enumeration value="STAND"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="quest-system-message"><xs:restriction base="xs:string"><xs:enumeration value="QUEST_FAILED"/><xs:enumeration value="WAREHOUSE_FULL_INVENTORY"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="quest-system-message-target"><xs:restriction base="xs:string"><xs:enumeration value="NONE"/><xs:enumeration value="PLAYER"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="quest-gender"><xs:restriction base="xs:string"><xs:enumeration value="MALE"/><xs:enumeration value="FEMALE"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="ascension-state"><xs:restriction base="xs:int"><xs:enumeration value="0"/><xs:enumeration value="1"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="recipe-ownership"><xs:restriction base="xs:string"><xs:enumeration value="QUEST_OWNED"/><xs:enumeration value="PERMANENT"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="reward-amount-mode"><xs:restriction base="xs:string"><xs:enumeration value="EXACT"/><xs:enumeration value="QUEST_BASE"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="quest-state-sync-mode"><xs:restriction base="xs:string"><xs:enumeration value="PACKET_ONLY"/><xs:enumeration value="VISIBILITY_REFRESH"/><xs:enumeration value="LEVEL_AND_VISIBILITY_REFRESH"/><xs:enumeration value="COMPLETION"/></xs:restriction></xs:simpleType>
  <xs:complexType name="empty-type"/>

  <xs:attributeGroup name="timer-policy-attributes">
    <xs:attribute name="timer-id" type="xs:string" use="required"/>
    <xs:attribute name="scope" type="timer-scope" use="required"/>
    <xs:attribute name="persistence" type="timer-persistence" use="required"/>
    <xs:attribute name="overwrite" type="timer-overwrite" use="required"/>
    <xs:attribute name="delivery" type="timer-delivery" use="required"/>
  </xs:attributeGroup>

  <xs:complexType name="event-type"><xs:choice>
    <xs:element name="talk-to-npc"><xs:complexType><xs:attribute name="npc-id" type="xs:int" use="required"/><xs:attribute name="dialog"/><xs:attribute name="dialog-id" type="xs:int"/><xs:attribute name="dialog-ids" type="xs:string"/></xs:complexType></xs:element>
    <xs:element name="kill-npc"><xs:complexType><xs:attribute name="npc-id" type="xs:int"/><xs:attribute name="npc-ids" type="xs:string"/></xs:complexType></xs:element>
    <xs:element name="attack-npc"><xs:complexType><xs:attribute name="npc-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="use-item"><xs:complexType><xs:attribute name="item-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="quest-dialog"><xs:complexType><xs:attribute name="dialog" type="xs:string"/><xs:attribute name="dialog-id" type="xs:int"/></xs:complexType></xs:element>
    <xs:element name="collect-item"><xs:complexType><xs:attribute name="item-id" type="xs:int" use="required"/><xs:attribute name="count" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="item-play"><xs:complexType><xs:attribute name="item-id" type="xs:int" use="required"/><xs:attribute name="animation-millis" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="house-item-use"><xs:complexType><xs:attribute name="item-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="get-item"><xs:complexType><xs:attribute name="item-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="level-up" type="empty-type"/><xs:element name="zone-mission-end" type="empty-type"/><xs:element name="die" type="empty-type"/><xs:element name="log-out" type="empty-type"/><xs:element name="abandon" type="empty-type"/><xs:element name="enter-world" type="empty-type"/>
    <xs:element name="enter-zone"><xs:complexType><xs:attribute name="zone" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="leave-zone"><xs:complexType><xs:attribute name="zone" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="pass-flying-ring"><xs:complexType><xs:attribute name="ring" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="movie-end"><xs:complexType><xs:attribute name="movie-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="quest-timer-end" type="empty-type"/><xs:element name="invisible-timer-end" type="empty-type"/>
    <xs:element name="kill-ranked"><xs:complexType><xs:attribute name="rank-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="kill-in-world"><xs:complexType><xs:attribute name="world-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="use-skill"><xs:complexType><xs:attribute name="skill-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="fail-craft"><xs:complexType><xs:attribute name="item-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="equip-item"><xs:complexType><xs:attribute name="item-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="can-act"><xs:complexType><xs:attribute name="template-id" type="xs:int" use="required"/><xs:attribute name="action-type" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="dredgion-reward" type="empty-type"/><xs:element name="kamar-reward" type="empty-type"/><xs:element name="ophidan-reward" type="empty-type"/><xs:element name="bastion-reward" type="empty-type"/>
    <xs:element name="bonus-apply"><xs:complexType><xs:attribute name="bonus-type" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="add-aggro-list"><xs:complexType><xs:attribute name="npc-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="at-distance"><xs:complexType><xs:attribute name="npc-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="protect-end" type="empty-type"/><xs:element name="protect-fail" type="empty-type"/>
    <xs:element name="enter-wind-stream"><xs:complexType><xs:attribute name="teleport-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="ride-action"><xs:complexType><xs:attribute name="item-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="creativity-point" type="empty-type"/><xs:element name="npc-reach-target" type="empty-type"/><xs:element name="npc-lost-target" type="empty-type"/>
  </xs:choice></xs:complexType>

  <xs:complexType name="conditions-type"><xs:choice minOccurs="0" maxOccurs="unbounded">
    <xs:element name="status-is"><xs:complexType><xs:attribute name="status" type="status" use="required"/></xs:complexType></xs:element>
    <xs:element name="has-item"><xs:complexType><xs:attribute name="item-id" type="xs:int" use="required"/><xs:attribute name="count" type="xs:int" use="required"/><xs:attribute name="expected" type="xs:boolean" default="true"/></xs:complexType></xs:element>
    <xs:element name="variable-is"><xs:complexType><xs:attribute name="field" type="xs:string" use="required"/><xs:attribute name="value" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="variable-at-least"><xs:complexType><xs:attribute name="field" type="xs:string" use="required"/><xs:attribute name="value" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="variable-below"><xs:complexType><xs:attribute name="field" type="xs:string" use="required"/><xs:attribute name="value" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="variable-sum-is"><xs:complexType><xs:attribute name="fields" type="xs:string" use="required"/><xs:attribute name="value" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="variable-sum-below"><xs:complexType><xs:attribute name="fields" type="xs:string" use="required"/><xs:attribute name="value" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="recipe-known"><xs:complexType><xs:attribute name="recipe-id" type="xs:int" use="required"/><xs:attribute name="expected" type="xs:boolean" use="required"/></xs:complexType></xs:element>
    <xs:element name="can-grant-craft-skill"><xs:complexType><xs:attribute name="skill-id" type="xs:int" use="required"/><xs:attribute name="target-level" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="pvp-victim-level-delta"><xs:complexType><xs:attribute name="minimum" type="xs:int" use="required"/><xs:attribute name="maximum" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="pvp-recipient-in-zone"><xs:complexType><xs:attribute name="zone" type="xs:string" use="required"/></xs:complexType></xs:element>
	<xs:element name="start-eligible" type="empty-type"/>
    <xs:element name="player-class-is"><xs:complexType><xs:attribute name="starting-class" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="advanced-class-is"><xs:complexType><xs:attribute name="class" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="gender-is"><xs:complexType><xs:attribute name="gender" type="quest-gender" use="required"/></xs:complexType></xs:element>
    <xs:element name="player-in-group"><xs:complexType><xs:attribute name="expected" type="xs:boolean" default="true"/></xs:complexType></xs:element>
    <xs:element name="world-is"><xs:complexType><xs:attribute name="world-id" type="xs:int" use="required"/><xs:attribute name="expected" type="xs:boolean" default="true"/></xs:complexType></xs:element>
    <xs:element name="world-npc-is"><xs:complexType><xs:attribute name="npc-id" type="xs:int" use="required"/><xs:attribute name="expected" type="xs:boolean" default="true"/></xs:complexType></xs:element>
	<xs:element name="zone-is"><xs:complexType><xs:attribute name="zone" type="xs:string" use="required"/><xs:attribute name="expected" type="xs:boolean" default="true"/></xs:complexType></xs:element>
    <xs:element name="npc-hp-below-percent"><xs:complexType><xs:attribute name="npc-id" type="xs:int" use="required"/><xs:attribute name="percent" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="currency-at-least"><xs:complexType><xs:attribute name="kind" type="xs:string" use="required"/><xs:attribute name="amount" type="xs:long" use="required"/></xs:complexType></xs:element>
    <xs:element name="currency-below"><xs:complexType><xs:attribute name="kind" type="xs:string" use="required"/><xs:attribute name="amount" type="xs:long" use="required"/></xs:complexType></xs:element>
    <xs:element name="quests-finished"><xs:complexType><xs:attribute name="quest-ids" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="equipment-set-equipped"><xs:complexType><xs:attribute name="set-ids" type="xs:string" use="required"/><xs:attribute name="count" type="xs:int" use="required"/><xs:attribute name="expected" type="xs:boolean" default="true"/></xs:complexType></xs:element>
    <xs:element name="equipped-item"><xs:complexType><xs:attribute name="item-id" type="xs:int" use="required"/><xs:attribute name="count" type="xs:int" default="1"/><xs:attribute name="expected" type="xs:boolean" default="true"/></xs:complexType></xs:element>
    <xs:element name="membership-permission"><xs:complexType><xs:attribute name="permission" type="xs:string" use="required"/><xs:attribute name="expected" type="xs:boolean" default="true"/></xs:complexType></xs:element>
    <xs:element name="dp-at-max" type="empty-type"/>
  </xs:choice></xs:complexType>

  <xs:complexType name="actions-type"><xs:choice minOccurs="0" maxOccurs="unbounded">
    <xs:element name="remove-item"><xs:complexType><xs:attribute name="item-id" type="xs:int" use="required"/><xs:attribute name="count" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="give-item"><xs:complexType><xs:attribute name="item-id" type="xs:int" use="required"/><xs:attribute name="count" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="set-variable"><xs:complexType><xs:attribute name="field" type="xs:string" use="required"/><xs:attribute name="value" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="increment-variable"><xs:complexType><xs:attribute name="field" type="xs:string" use="required"/><xs:attribute name="delta" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="block-default-item-use"><xs:complexType/></xs:element>
    <xs:element name="set-status"><xs:complexType><xs:attribute name="status" type="status" use="required"/></xs:complexType></xs:element>
	<xs:element name="grant-reward"><xs:complexType><xs:attribute name="kind" type="xs:string" use="required"/><xs:attribute name="id" type="xs:int" use="required"/><xs:attribute name="amount" type="xs:long" use="required"/><xs:attribute name="amount-mode" type="reward-amount-mode" default="EXACT"/></xs:complexType></xs:element>
	<xs:element name="complete-quest"><xs:complexType><xs:attribute name="reward-index" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="learn-recipe"><xs:complexType><xs:attribute name="recipe-id" type="xs:int" use="required"/><xs:attribute name="ownership" type="recipe-ownership" use="required"/></xs:complexType></xs:element>
    <xs:element name="forget-recipe"><xs:complexType><xs:attribute name="recipe-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="grant-craft-skill"><xs:complexType><xs:attribute name="skill-id" type="xs:int" use="required"/><xs:attribute name="target-level" type="xs:int" use="required"/><xs:attribute name="auto-learn-recipes" type="xs:boolean" use="required"/></xs:complexType></xs:element>
  </xs:choice></xs:complexType>

  <xs:complexType name="after-commit-type"><xs:choice minOccurs="0" maxOccurs="unbounded">
    <xs:element name="close-dialog" type="empty-type"/>
	<xs:element name="sync-quest-state"><xs:complexType><xs:attribute name="mode" type="quest-state-sync-mode" use="required"/></xs:complexType></xs:element>
	<xs:element name="refresh-player-stats" type="empty-type"/>
    <xs:element name="show-quest-dialog"><xs:complexType><xs:attribute name="dialog-id" type="xs:int" use="required"/></xs:complexType></xs:element>
	<xs:element name="show-quest-selection-dialog"><xs:complexType><xs:attribute name="dialog-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="show-dialog-window"><xs:complexType><xs:attribute name="dialog-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="teleport-player-current-or-default"><xs:complexType><xs:attribute name="world-id" type="xs:int" use="required"/><xs:attribute name="x" type="xs:float" use="required"/><xs:attribute name="y" type="xs:float" use="required"/><xs:attribute name="z" type="xs:float" use="required"/><xs:attribute name="heading" type="xs:byte" use="required"/></xs:complexType></xs:element>
    <xs:element name="teleport-player-fixed-instance"><xs:complexType><xs:attribute name="instance-id" type="xs:int" use="required"/><xs:attribute name="world-id" type="xs:int" use="required"/><xs:attribute name="x" type="xs:float" use="required"/><xs:attribute name="y" type="xs:float" use="required"/><xs:attribute name="z" type="xs:float" use="required"/><xs:attribute name="heading" type="xs:byte" use="required"/></xs:complexType></xs:element>
    <xs:element name="teleport-player-next-available-instance"><xs:complexType><xs:attribute name="world-id" type="xs:int" use="required"/><xs:attribute name="x" type="xs:float" use="required"/><xs:attribute name="y" type="xs:float" use="required"/><xs:attribute name="z" type="xs:float" use="required"/><xs:attribute name="heading" type="xs:byte" use="required"/></xs:complexType></xs:element>
    <xs:element name="play-movie"><xs:complexType><xs:attribute name="movie-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="morph"><xs:complexType><xs:attribute name="ascension-id" type="ascension-state" use="required"/></xs:complexType></xs:element>
    <xs:element name="set-class"><xs:complexType><xs:attribute name="class" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="apply-effect"><xs:complexType><xs:attribute name="skill-id" type="xs:int" use="required"/><xs:attribute name="duration-ms" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="remove-effect"><xs:complexType><xs:attribute name="effect-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="system-message"><xs:complexType><xs:attribute name="message" type="quest-system-message"/><xs:attribute name="message-id" type="xs:int"/><xs:attribute name="target" type="quest-system-message-target" default="NONE"/><xs:attribute name="npc-shout" type="xs:boolean" default="false"/><xs:attribute name="text-color-id" type="xs:int" default="26"/><xs:attribute name="params" type="xs:string"/></xs:complexType></xs:element>
    <xs:element name="player-emotion"><xs:complexType><xs:attribute name="emotion" type="player-emotion" use="required"/></xs:complexType></xs:element>
    <xs:element name="add-npc-aggro"><xs:complexType><xs:attribute name="npc-id" type="xs:int" use="required"/><xs:attribute name="damage" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="flight-teleport"><xs:complexType><xs:attribute name="flight-teleport-id" type="xs:int" use="required"/></xs:complexType></xs:element>
    <xs:element name="broadcast-zone-mission-end"><xs:complexType><xs:attribute name="quest-ids" type="xs:string" use="required"/></xs:complexType></xs:element><xs:element name="delete-interaction-npc"><xs:complexType><xs:attribute name="schedule-respawn" type="xs:boolean" default="true"/></xs:complexType></xs:element><xs:element name="delete-world-npcs" type="empty-type"/>
    <xs:element name="spawn-npc-current-or-default"><xs:complexType><xs:attribute name="slot" type="xs:string" use="required"/><xs:attribute name="template-id" type="xs:int" use="required"/><xs:attribute name="world-id" type="xs:int" use="required"/><xs:attribute name="x" type="xs:float" use="required"/><xs:attribute name="y" type="xs:float" use="required"/><xs:attribute name="z" type="xs:float" use="required"/><xs:attribute name="heading" type="xs:byte" use="required"/></xs:complexType></xs:element>
    <xs:element name="spawn-npc-fixed-instance"><xs:complexType><xs:attribute name="slot" type="xs:string" use="required"/><xs:attribute name="template-id" type="xs:int" use="required"/><xs:attribute name="world-id" type="xs:int" use="required"/><xs:attribute name="instance-id" type="xs:int" use="required"/><xs:attribute name="x" type="xs:float" use="required"/><xs:attribute name="y" type="xs:float" use="required"/><xs:attribute name="z" type="xs:float" use="required"/><xs:attribute name="heading" type="xs:byte" use="required"/></xs:complexType></xs:element>
    <xs:element name="spawn-npc-at-player"><xs:complexType><xs:attribute name="slot" type="xs:string" use="required"/><xs:attribute name="template-id" type="xs:int" use="required"/><xs:attribute name="heading" type="xs:byte" use="required"/></xs:complexType></xs:element>
    <xs:element name="despawn-npc"><xs:complexType><xs:attribute name="slot" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="start-follow"><xs:complexType><xs:attribute name="slot" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="start-follow-current-target"><xs:complexType><xs:attribute name="x" type="xs:float" use="required"/><xs:attribute name="y" type="xs:float" use="required"/><xs:attribute name="z" type="xs:float" use="required"/></xs:complexType></xs:element>
    <xs:element name="stop-follow"><xs:complexType><xs:attribute name="slot" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="attack-target"><xs:complexType><xs:attribute name="slot" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="start-walking"><xs:complexType><xs:attribute name="slot" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="broadcast-npc-emotion"><xs:complexType><xs:attribute name="slot" type="xs:string" use="required"/><xs:attribute name="emotion" type="npc-emotion" use="required"/></xs:complexType></xs:element>
    <xs:element name="watch-follow-zone"><xs:complexType><xs:attribute name="slot" type="xs:string" use="required"/><xs:attribute name="zone" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="start-quest-timer"><xs:complexType><xs:attribute name="seconds" type="xs:int" use="required"/><xs:attributeGroup ref="timer-policy-attributes"/></xs:complexType></xs:element>
    <xs:element name="start-invisible-timer"><xs:complexType><xs:attribute name="seconds" type="xs:int" use="required"/><xs:attributeGroup ref="timer-policy-attributes"/></xs:complexType></xs:element>
    <xs:element name="cancel-quest-timer"><xs:complexType><xs:attribute name="timer-id" type="xs:string" use="required"/><xs:attribute name="scope" type="timer-scope" use="required"/></xs:complexType></xs:element>
  </xs:choice></xs:complexType>

  <xs:element name="quest-definition">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="metadata"><xs:complexType><xs:sequence>
          <xs:element name="races" minOccurs="0"><xs:complexType><xs:sequence><xs:element name="race" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:attribute name="id" use="required"/></xs:complexType></xs:element></xs:sequence></xs:complexType></xs:element>
          <xs:element name="classes" minOccurs="0"><xs:complexType><xs:sequence><xs:element name="class" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:attribute name="id" use="required"/></xs:complexType></xs:element></xs:sequence></xs:complexType></xs:element>
          <xs:element name="gender" minOccurs="0"><xs:complexType><xs:attribute name="id" use="required"/></xs:complexType></xs:element>
