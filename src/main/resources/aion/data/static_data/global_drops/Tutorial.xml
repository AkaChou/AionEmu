<?xml version="1.0" encoding="UTF-8"?>
<global_rules>
<!-- 本文件仅为 global_rules.xml 格式的编写示例文档，不参与静态数据加载。
     This file is only a documentation sample of the global_rules.xml format; it is never loaded as static data. -->
<!--
Tutorial:
==========================================================

rule_name="Test" [name for this global drop rule]
==========================================================

min_count="1" max_count="1" [min/max item count]
==========================================================

base_chance="15" [% chance to drop item before rate modifiers]
==========================================================

min_diff="1" max_diff="83"> [allowed difference: NPC level - item level]
==========================================================

<gd_world wd_type="ILUMA"/>
[Ex: Iluma, don't forget to add "drop_type" in "world_maps.xml"
Ex: <map id="210100000" name="Iluma" drop_type="ILUMA"]
==========================================================

You can add more "World" one below the other !!!
<gd_worlds>
    <gd_world wd_type="HEIRON"/>
	<gd_world wd_type="BELUSLAN"/>
	<gd_world wd_type="THEOBOMOS"/>
	<gd_world wd_type="BRUSTHONIN"/>
	<gd_world wd_type="INGGISON"/>
	<gd_world wd_type="GELKMAROS"/>
</gd_worlds>
==========================================================

<gd_rating rating="NORMAL"/> [only mobs with matching rating can drop this item]

You can add more "Rating" one below the other !!!
<gd_ratings>
    <gd_rating rating="NORMAL"/>
	<gd_rating rating="ELITE"/>
</gd_ratings>
==========================================================

<gd_item id="190000083" name="Golden Narki's Egg"/> [ItemId + Item Name]
==========================================================
-->
</global_rules>
